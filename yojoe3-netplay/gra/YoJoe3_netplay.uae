; Yo! Joe! 3 - konfiguracja WinUAE do gry online (netplay)
; Obaj gracze musza uzywac TEGO SAMEGO pliku (inaczej host odrzuci polaczenie
; i wypisze, ktore ustawienia sie roznia).
;
; Amiga 500 PAL, OCS, 512 KB Chip + 512 KB Slow, CPU 68000 cycle-exact,
; dwie stacje dyskow (DF0 = dysk A, DF1 = dysk B).
; ROM: wbudowany w WinUAE AROS (taki sam u kazdego). Jesli obaj gracze maja
; IDENTYCZNY Kickstart 1.3, mozna podmienic kickstart_rom_file na sciezke do niego.
config_description=Yo! Joe! 3 - netplay (A500, 512K chip + 512K slow)
use_gui=no
quickstart=a500,0
kickstart_rom_file=:AROS
chipmem_size=1
bogomem_size=2
fastmem_size=0
nr_floppies=2
floppy0type=0
floppy1type=0
floppy_speed=100
cpu_speed=real
sound_output=exact
show_leds=true
joyport0=mouse
joyport1=kbd2
