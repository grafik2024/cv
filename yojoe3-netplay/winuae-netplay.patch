+ /*
+  * UAE - The Un*x Amiga Emulator
+  *
+  * Netplay: two emulators run the same Amiga in lockstep over TCP.
+  * Only input events travel over the network, both sides emulate.
+  *
+  */
+
+#ifndef UAE_NETPLAY_H
+#define UAE_NETPLAY_H
+
+#include "uae/types.h"
+
+#define NETPLAY_MODE_OFF 0
+#define NETPLAY_MODE_HOST 1
+#define NETPLAY_MODE_CLIENT 2
+
+#define NETPLAY_DEFAULT_PORT 25200
+
+/* true while a session is running in lockstep */
+extern bool netplay_active(void);
+/* netplay requested in config but session not yet started */
+extern bool netplay_pending(void);
+/* blocking connect + handshake, called once before the first hard reset */
+extern bool netplay_start(void);
+extern void netplay_stop(const TCHAR *reason);
+
+/* local input event, returns true if netplay took it (do not apply now) */
+extern bool netplay_capture_event(int nr, int state, int max, int autofire);
+/* frame boundary (vpos == 0): send local input, wait for remote input */
+extern void netplay_frame(void);
+/* events to apply for the current frame, same order on both machines */
+extern bool netplay_playevent(int *nr, int *state, int *max, int *autofire);
+/* reset requested by user (GUI/hotkey), returns true if it was synchronized */
+extern bool netplay_request_reset(int hardreset, int keyboardreset);
+/* inputcodes (AKS_xxx) that would only change one machine are refused */
+extern bool netplay_allow_inputcode(int code, int state);
+/* emulated port types used during the session */
+extern bool netplay_port_is_mouse(int port);
+
+extern void netplay_getstatus(TCHAR *out);
+extern void netplay_exit(void);
+
+#endif /* UAE_NETPLAY_H */
