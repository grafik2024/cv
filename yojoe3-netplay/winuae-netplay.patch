+bool user_quit(void)
+{
+	if (quit_program == -UAE_QUIT || quit_program == UAE_QUIT)
+		return true;
+	if (np_state == NP_HANDSHAKE && esc_pressed()) {
+		np_cancelled = true;
+		return true;
+	}
+	return false;
+}
+
+void pump_host(void)
+{
+	static uae_s64 last;
+	uae_s64 t = now_ms();
+	if (t - last >= 10) {
+		last = t;
+		handle_msgpump(true);
+	}
+}
+
+// wait until a message of given type is queued
+bool wait_msg(uae_u8 type, npmsg &out, int timeout_ms)
+{
+	uae_s64 start = now_ms();
+	for (;;) {
+		for (auto it = inbox.begin(); it != inbox.end(); ++it) {
+			if (it->type == type) {
+				out = std::move(*it);
+				inbox.erase(it);
+				return true;
+			}
+		}
+		if (!np_poll(5))
+			return false;
+		pump_host();
+		if (user_quit()) {
+			fail(_T("Cancelled."));
+			return false;
+		}
+		if (timeout_ms > 0 && now_ms() - start > timeout_ms) {
+			fail(_T("Partner did not respond (timeout)."));
+			return false;
+		}
+	}
+}
+
+// IPv4 addresses of this computer (LAN, VPN), to tell player 2
+std::string local_addresses(void)
+{
+	std::string out;
+	auto add = [&out](const char *ip) {
+		if (!strncmp(ip, "127.", 4) || !strncmp(ip, "169.254.", 8) || out.find(ip) != std::string::npos)
+			return;
+		if (!out.empty())
+			out += ", ";
+		out += ip;
+	};
+#ifdef _WIN32
+	char name[256];
+	if (!start_sockets() || gethostname(name, sizeof name))
+		return out;
+	struct addrinfo hints, *res = NULL;
+	memset(&hints, 0, sizeof hints);
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_STREAM;
+	if (getaddrinfo(name, NULL, &hints, &res) || !res)
+		return out;
+	for (struct addrinfo *a = res; a; a = a->ai_next) {
+		char ip[64];
+		if (!getnameinfo(a->ai_addr, (int)a->ai_addrlen, ip, sizeof ip, NULL, 0, NI_NUMERICHOST))
+			add(ip);
+	}
+	freeaddrinfo(res);
+#else
+	struct ifaddrs *ifa = NULL;
+	if (getifaddrs(&ifa))
+		return out;
+	for (struct ifaddrs *a = ifa; a; a = a->ifa_next) {
+		char ip[64];
+		if (a->ifa_addr && a->ifa_addr->sa_family == AF_INET &&
+			!getnameinfo(a->ifa_addr, sizeof(struct sockaddr_in), ip, sizeof ip, NULL, 0, NI_NUMERICHOST))
+			add(ip);
+	}
+	freeifaddrs(ifa);
+#endif
+	return out;
+}
