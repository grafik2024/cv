+struct npbuf
+{
+	std::vector<uae_u8> d;
+	void u8(uae_u8 v) { d.push_back(v); }
+	void u16(uae_u16 v) { u8((uae_u8)(v >> 8)); u8((uae_u8)v); }
+	void u32(uae_u32 v) { u16((uae_u16)(v >> 16)); u16((uae_u16)v); }
+	void str(const std::string &s)
+	{
+		size_t len = s.size() > 65535 ? 65535 : s.size();
+		u16((uae_u16)len);
+		d.insert(d.end(), s.begin(), s.begin() + len);
+	}
+	void bytes(const uae_u8 *p, size_t len) { d.insert(d.end(), p, p + len); }
+};
+
+struct npreader
+{
+	const uae_u8 *p;
+	size_t len, pos;
+	bool bad;
+	npreader(const std::vector<uae_u8> &v) : p(v.data()), len(v.size()), pos(0), bad(false) { }
+	uae_u8 u8(void)
+	{
+		if (pos + 1 > len) {
+			bad = true;
+			return 0;
+		}
+		return p[pos++];
+	}
+	uae_u16 u16(void) { uae_u16 v = u8() << 8; return v | u8(); }
+	uae_u32 u32(void) { uae_u32 v = u16() << 16; return v | u16(); }
+	std::string str(void)
+	{
+		size_t l = u16();
+		if (bad || pos + l > len) {
+			bad = true;
+			return std::string();
+		}
+		std::string s((const char*)p + pos, l);
+		pos += l;
+		return s;
+	}
+	const uae_u8 *bytes(size_t l)
+	{
+		if (pos + l > len) {
+			bad = true;
+			return NULL;
+		}
+		const uae_u8 *r = p + pos;
+		pos += l;
+		return r;
+	}
+};
