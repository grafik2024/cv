 /* Handle messages for the IO Settings page of our property-sheet */
+static void enable_for_netplaydlg(HWND hDlg)
+{
+	bool on = workprefs.netplay_mode != NETPLAY_MODE_OFF;
+	bool host = workprefs.netplay_mode == NETPLAY_MODE_HOST;
+	// player 2 gets delay and port settings from the host
+	ew(hDlg, IDC_NETPLAY_ADDRESS, workprefs.netplay_mode == NETPLAY_MODE_CLIENT);
+	ew(hDlg, IDC_NETPLAY_PORT, on);
+	ew(hDlg, IDC_NETPLAY_PASSWORD, on);
+	ew(hDlg, IDC_NETPLAY_DELAY, host);
+	ew(hDlg, IDC_NETPLAY_SWAPPORTS, host);
+	ew(hDlg, IDC_NETPLAY_MOUSE, host);
+	ew(hDlg, IDC_NETPLAY_UPNP, host);
+}
+
+static void values_to_netplaydlg(HWND hDlg)
+{
+	TCHAR tmp[1000];
+	int id = IDC_NETPLAY_OFF;
+	if (workprefs.netplay_mode == NETPLAY_MODE_HOST)
+		id = IDC_NETPLAY_HOST;
+	else if (workprefs.netplay_mode == NETPLAY_MODE_CLIENT)
+		id = IDC_NETPLAY_JOIN;
+	CheckRadioButton(hDlg, IDC_NETPLAY_OFF, IDC_NETPLAY_JOIN, id);
+	SetDlgItemText(hDlg, IDC_NETPLAY_ADDRESS, workprefs.netplay_address);
+	SetDlgItemInt(hDlg, IDC_NETPLAY_PORT, workprefs.netplay_port > 0 ? workprefs.netplay_port : NETPLAY_DEFAULT_PORT, FALSE);
+	SetDlgItemText(hDlg, IDC_NETPLAY_PASSWORD, workprefs.netplay_password);
+	SetDlgItemInt(hDlg, IDC_NETPLAY_DELAY, workprefs.netplay_delay, FALSE);
+	CheckDlgButton(hDlg, IDC_NETPLAY_SWAPPORTS, workprefs.netplay_swapports);
+	CheckDlgButton(hDlg, IDC_NETPLAY_MOUSE, workprefs.netplay_mouse);
+	CheckDlgButton(hDlg, IDC_NETPLAY_UPNP, workprefs.netplay_upnp);
+	netplay_getinfo(tmp, sizeof tmp / sizeof(TCHAR));
+	SetDlgItemText(hDlg, IDC_NETPLAY_STATUS, tmp);
+	enable_for_netplaydlg(hDlg);
+}
+
+static void values_from_netplaydlg(HWND hDlg)
+{
+	BOOL ok;
+	int v;
+	workprefs.netplay_mode = NETPLAY_MODE_OFF;
+	if (ischecked(hDlg, IDC_NETPLAY_HOST))
+		workprefs.netplay_mode = NETPLAY_MODE_HOST;
+	else if (ischecked(hDlg, IDC_NETPLAY_JOIN))
+		workprefs.netplay_mode = NETPLAY_MODE_CLIENT;
+	GetDlgItemText(hDlg, IDC_NETPLAY_ADDRESS, workprefs.netplay_address, sizeof workprefs.netplay_address / sizeof(TCHAR));
+	GetDlgItemText(hDlg, IDC_NETPLAY_PASSWORD, workprefs.netplay_password, sizeof workprefs.netplay_password / sizeof(TCHAR));
+	v = GetDlgItemInt(hDlg, IDC_NETPLAY_PORT, &ok, FALSE);
+	if (ok && v > 0 && v < 65536)
+		workprefs.netplay_port = v;
+	v = GetDlgItemInt(hDlg, IDC_NETPLAY_DELAY, &ok, FALSE);
+	if (ok && v >= 0 && v <= 15)
+		workprefs.netplay_delay = v;
+	workprefs.netplay_swapports = ischecked(hDlg, IDC_NETPLAY_SWAPPORTS);
+	workprefs.netplay_mouse = ischecked(hDlg, IDC_NETPLAY_MOUSE);
+	workprefs.netplay_upnp = ischecked(hDlg, IDC_NETPLAY_UPNP);
+	enable_for_netplaydlg(hDlg);
+}
+
+static INT_PTR CALLBACK NetplayDlgProc(HWND hDlg, UINT msg, WPARAM wParam, LPARAM lParam)
+{
+	static int recursive = 0;
+
+	bool handled;
+	INT_PTR vv = commonproc2(hDlg, msg, wParam, lParam, &handled);
+	if (handled) {
+		return vv;
+	}
+
+	switch (msg)
+	{
+	case WM_INITDIALOG:
+		recursive++;
+		pages[NETPLAY_ID] = hDlg;
+		currentpage = NETPLAY_ID;
+		SendDlgItemMessage(hDlg, IDC_NETPLAY_ADDRESS, EM_LIMITTEXT, sizeof workprefs.netplay_address / sizeof(TCHAR) - 1, 0);
+		SendDlgItemMessage(hDlg, IDC_NETPLAY_PASSWORD, EM_LIMITTEXT, sizeof workprefs.netplay_password / sizeof(TCHAR) - 1, 0);
+		values_to_netplaydlg(hDlg);
+		recursive--;
+		break;
+	case WM_USER:
+		recursive++;
+		values_to_netplaydlg(hDlg);
+		recursive--;
+		return TRUE;
+	case WM_COMMAND:
+		if (recursive > 0)
+			break;
+		if (HIWORD(wParam) != BN_CLICKED && HIWORD(wParam) != EN_CHANGE)
+			break;
+		recursive++;
+		values_from_netplaydlg(hDlg);
+		recursive--;
+		break;
+	}
+	return FALSE;
+}
