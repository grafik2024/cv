+// config lines that matter for emulation, host specific lines are skipped
+bool config_key_ignored(const std::string &k)
+{
+	// sound emulation itself must match, output settings do not matter
+	if (k == "sound_output")
+		return false;
+	// switched off on both machines by apply_session()
+	if (k == "rtc" || k == "synchronize_clock")
+		return true;
+	static const char *prefixes[] = {
+		"config_", "win32.", "unix.", "amiberry.", "use_gui", "use_debugger", "debugging_", "gdb_port",
+		"kickstart_rom_file", "kickstart_ext_rom_file", "kickstart_key_file", "flash_file", "rtc_file", "cart_file", "cart",
+		"diskimage", "floppy_path", "rom_path", "hardfile_path", "cd_path",
+		"floppy_volume", "floppy_channel_mask", "floppy_samples",
+		"gfx_", "show_", "statusbar", "sound_", "kbd_lang",
+		"serial_", "parallel_", "midi", "sampler", "statefile", "inprec", "trainerfile", "lua",
+		"netplay", "rndseed", "headless", "ghostscript", "joyport", "chipset_refreshrate", "displaydata",
+		// warp is switched on both machines by netplay
+		"warp",
+		// JIT is refused in netplay, RTG modes are host display choices
+		"comp_", "compfpu", "rtg_modes",
+		NULL
+	};
+	for (int i = 0; prefixes[i]; i++) {
+		if (!k.compare(0, strlen(prefixes[i]), prefixes[i]))
+			return true;
+	}
+	// floppyN path, floppyNwp, floppyNsound*, floppyNsubtype*
+	if (k.size() >= 7 && !k.compare(0, 6, "floppy") && k[6] >= '0' && k[6] <= '9') {
+		std::string rest = k.substr(7);
+		if (rest.empty() || rest == "wp" || !rest.compare(0, 5, "sound") || !rest.compare(0, 7, "subtype"))
+			return true;
+	}
+	// host input mapping, except settings that change emulated port values
+	if (!k.compare(0, 6, "input.")) {
+		if (k == "input.autofire_linecnt" || !k.compare(0, 23, "input.analog_joystick_m") || !k.compare(0, 23, "input.analog_joystick_o"))
+			return false;
+		return true;
+	}
+	return false;
+}
+
+// same rules for own and received lines, so host and client filters may differ
+void normalize_config(std::map<std::string, std::string> &m)
+{
+	for (auto it = m.begin(); it != m.end(); ) {
+		if (config_key_ignored(it->first))
+			it = m.erase(it);
+		else
+			++it;
+	}
+	// interrupts/normal/exact emulate Paula identically, only "none" differs
+	auto snd = m.find("sound_output");
+	if (snd != m.end() && snd->second != "none")
+		snd->second = "emulated";
+	// Zorro III start address differs between host platforms, unused without Z3 RAM
+	auto z3 = m.find("z3mem_size");
+	if (z3 == m.end() || z3->second == "0")
+		m.erase("z3mem_start");
+}
+
+std::map<std::string, std::string> config_lines(struct uae_prefs *p)
+{
+	std::map<std::string, std::string> out;
+	struct zfile *f = zfile_fopen_empty(NULL, _T("netplay.uae"));
+	if (!f)
+		return out;
+	cfgfile_save_options(f, p, 0);
+	int len = 0;
+	uae_u8 *data = zfile_getdata(f, 0, -1, &len);
+	zfile_fclose(f);
+	if (!data)
+		return out;
+	std::string s((const char*)data, len);
+	xfree(data);
+	size_t pos = 0;
+	while (pos < s.size()) {
+		size_t e = s.find('\n', pos);
+		if (e == std::string::npos)
+			e = s.size();
+		std::string line = s.substr(pos, e - pos);
+		pos = e + 1;
+		while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+			line.pop_back();
+		if (line.empty() || line[0] == ';')
+			continue;
+		size_t eq = line.find('=');
+		if (eq == std::string::npos)
+			continue;
+		std::string k = line.substr(0, eq);
+		if (k.size() > 5 && !k.compare(k.size() - 5, 5, ".utf8"))
+			continue;
+		out[k] = line.substr(eq + 1);
+	}
+	normalize_config(out);
+	return out;
+}
+
+std::string config_text(void)
+{
+	std::string s;
+	// currprefs holds temporary startup values (sound off), compare user settings
+	auto m = config_lines(&changed_prefs);
+	for (auto &kv : m)
+		s += kv.first + "=" + kv.second + "\n";
+	return s;
+}
+
+std::string compare_config(const std::string &hosttext)
+{
+	std::map<std::string, std::string> h;
+	size_t pos = 0;
+	while (pos < hosttext.size()) {
+		size_t e = hosttext.find('\n', pos);
+		if (e == std::string::npos)
+			e = hosttext.size();
+		std::string line = hosttext.substr(pos, e - pos);
+		pos = e + 1;
+		size_t eq = line.find('=');
+		if (eq != std::string::npos)
+			h[line.substr(0, eq)] = line.substr(eq + 1);
+	}
+	normalize_config(h);
+	auto c = config_lines(&changed_prefs);
+	std::string diff;
+	int cnt = 0;
+	auto add = [&](const std::string &k, const std::string &hv, const std::string &cv) {
+		if (cnt++ < 12)
+			diff += k + ": host=" + (hv.empty() ? "(default)" : hv) + " client=" + (cv.empty() ? "(default)" : cv) + "\n";
+	};
+	for (auto &kv : h) {
+		auto it = c.find(kv.first);
+		if (it == c.end())
+			add(kv.first, kv.second, "");
+		else if (it->second != kv.second)
+			add(kv.first, kv.second, it->second);
+	}
+	for (auto &kv : c) {
+		if (h.find(kv.first) == h.end())
+			add(kv.first, "", kv.second);
+	}
+	if (cnt > 12)
+		diff += "...\n";
+	return diff;
+}
+
+const TCHAR *basename_of(const TCHAR *path)
+{
+	const TCHAR *p = path + _tcslen(path);
+	while (p > path && p[-1] != '/' && p[-1] != '\\' && p[-1] != ':')
+		p--;
+	return p;
+}
+
+// read (and unpack) a floppy image the way disk.cpp opens it
+bool load_image_file(const TCHAR *df_in, bool forcedwp, npdisk &d)
+{
+	TCHAR df[MAX_DPATH];
+	d.present = false;
+	d.data.clear();
+	cfgfile_resolve_path_out_load(df_in, df, MAX_DPATH, PATH_FLOPPY);
+	struct zfile *f = zfile_fopen(df, _T("rb"), ZFD_NORMAL);
+	if (!f)
+		return false;
+	int len = 0;
+	uae_u8 *data = zfile_getdata(f, 0, -1, &len);
+	const TCHAR *name = zfile_getfilename(f);
+	d.name = to_utf8(basename_of(name && name[0] ? name : df));
+	zfile_fclose(f);
+	if (!data)
+		return false;
+	d.data.assign(data, data + len);
+	xfree(data);
+	d.present = true;
+	d.size = (uae_u32)d.data.size();
+	d.crc = get_crc32(d.data.data(), (int)d.data.size());
+	// read-only image file is write protected in the drive, the copy of player 2 must be too
+	d.wp = forcedwp;
+	struct zfile *w = zfile_fopen(df, _T("r+b"), ZFD_NORMAL);
+	if (w)
+		zfile_fclose(w);
+	else
+		d.wp = true;
+	return true;
+}
+
+bool load_disk_image(int num, npdisk &d)
+{
+	d.present = false;
+	d.data.clear();
+	const TCHAR *df = currprefs.floppyslots[num].df;
+	if (!df[0] || currprefs.floppyslots[num].dfxtype < 0)
+		return true;
+	return load_image_file(df, currprefs.floppyslots[num].forcedwriteprotect, d);
+}
+
+// create missing directories of a path ending with a separator
+void make_dirs(const TCHAR *path)
+{
+	TCHAR tmp[MAX_DPATH];
+	_tcsncpy(tmp, path, MAX_DPATH - 1);
+	tmp[MAX_DPATH - 1] = 0;
+	for (TCHAR *p = tmp + 1; *p; p++) {
+		if (*p != '/' && *p != '\\')
+			continue;
+		TCHAR c = *p;
+		*p = 0;
+		if (tmp[0] && tmp[_tcslen(tmp) - 1] != ':' && !my_existsdir(tmp))
+			my_mkdir(tmp);
+		*p = c;
+	}
+}
+
+void disk_cache_path(TCHAR *out, int size, const npdisk &d)
+{
+	TCHAR name[MAX_DPATH];
+	fetch_saveimagepath(out, size, 1);
+	int l = uaetcslen(out);
+	if (l > 0 && out[l - 1] != '/' && out[l - 1] != '\\') {
+		out[l++] = FSDB_DIR_SEPARATOR;
+		out[l] = 0;
+	}
+	make_dirs(out);
+	from_utf8(name, sizeof name / sizeof(TCHAR), d.name);
+	// strip anything that could escape the directory
+	for (TCHAR *p = name; *p; p++) {
+		if (*p == '/' || *p == '\\' || *p == ':')
+			*p = '_';
+	}
+	_stprintf(out + l, _T("netplay_%08x_%s"), d.crc, name);
+}
+
+bool file_crc(const TCHAR *path, uae_u32 size, uae_u32 crc)
+{
+	struct zfile *f = zfile_fopen(path, _T("rb"), 0);
+	if (!f)
+		return false;
+	int len = 0;
+	uae_u8 *data = zfile_getdata(f, 0, -1, &len);
+	zfile_fclose(f);
+	bool ok = data && (uae_u32)len == size && get_crc32(data, len) == crc;
+	xfree(data);
+	return ok;
+}
+
+bool save_file(const TCHAR *path, const std::vector<uae_u8> &data)
+{
+	struct zfile *f = zfile_fopen(path, _T("wb"), 0);
+	if (!f)
+		return false;
+	bool ok = zfile_fwrite(data.data(), 1, data.size(), f) == data.size();
+	zfile_fclose(f);
+	return ok;
+}
+
+bool machine_check(TCHAR *err)
+{
+	if (currprefs.m68k_speed < 0) {
+		_tcscpy(err, _T("CPU speed \"Fastest possible\" depends on host speed and cannot be synchronized. Use \"Approximate A500/A1200 or cycle-exact\" CPU speed."));
+		return false;
+	}
+	if (currprefs.cachesize) {
+		_tcscpy(err, _T("JIT is not supported in netplay."));
+		return false;
+	}
+	if (currprefs.cpu_thread) {
+		_tcscpy(err, _T("Threaded CPU is not supported in netplay."));
+		return false;
+	}
+	if (savestate_state == STATE_DORESTORE || savestate_state == STATE_RESTORE) {
+		_tcscpy(err, _T("Netplay always starts from power-on, state files cannot be loaded at startup."));
+		return false;
+	}
+	return true;
+}
+
+void build_remap(void)
+{
+	for (int i = 0; i < INPUTEVENT_END; i++)
+		remap[i] = i;
+	if (is_host || !np_swapports)
+		return;
+	// client's joystick port events move to the mouse port
+	for (int i = 1; i < INPUTEVENT_END; i++) {
+		const struct inputevent *ie = inputdevice_get_eventinfo(i);
+		if (!ie || !ie->name || ie->unit != 2 || !ie->portid)
+			continue;
+		for (int j = 1; j < INPUTEVENT_END; j++) {
+			const struct inputevent *ie2 = inputdevice_get_eventinfo(j);
+			if (ie2 && ie2->name && ie2->unit == 1 && ie2->portid == ie->portid && ie2->type == ie->type) {
+				remap[i] = j;
+				break;
+			}
+		}
+	}
+}
+
+void load_debug_script(void)
+{
+	debug_steps.clear();
+	debug_pos = 0;
+	if (!currprefs.netplay_debug_input[0])
+		return;
+	struct zfile *f = zfile_fopen(currprefs.netplay_debug_input, _T("rb"), 0);
+	if (!f)
+		return;
+	int len = 0;
+	uae_u8 *data = zfile_getdata(f, 0, -1, &len);
+	zfile_fclose(f);
+	if (!data)
+		return;
+	std::string s((const char*)data, len);
+	xfree(data);
+	size_t pos = 0;
+	while (pos < s.size()) {
+		size_t e = s.find('\n', pos);
+		if (e == std::string::npos)
+			e = s.size();
+		std::string line = s.substr(pos, e - pos);
+		pos = e + 1;
+		char what[64], arg[256];
+		unsigned int frame;
+		int state = 0;
+		arg[0] = 0;
+		if (line.empty() || line[0] == '#' || sscanf(line.c_str(), "%u %63s %255s %d", &frame, what, arg, &state) < 2)
+			continue;
+		npdebugstep st;
+		st.frame = frame;
+		st.nr = 0;
+		st.state = state;
+		st.arg = arg;
+		if (!strcmp(what, "event")) {
+			st.action = 0;
+			TCHAR *name = au(arg);
+			for (int i = 1; i < INPUTEVENT_END; i++) {
+				const struct inputevent *ie = inputdevice_get_eventinfo(i);
+				if (ie && ie->confname && !_tcsicmp(ie->confname, name)) {
+					st.nr = i;
+					break;
+				}
+			}
+			xfree(name);
+			if (!st.nr) {
+				TCHAR *l = au(line.c_str());
+				write_log(_T("NETPLAY: debug script, unknown event '%s'\n"), l);
+				xfree(l);
+				continue;
+			}
+		} else if (!strcmp(what, "shot")) {
+			st.action = 1;
+		} else if (!strcmp(what, "quit")) {
+			st.action = 2;
+		} else if (!strcmp(what, "reset")) {
+			st.action = 3;
+		} else if (!strcmp(what, "warp")) {
+			st.action = 4;
+			st.state = atoi(arg);
+		} else if (!strcmp(what, "disk")) {
+			// <frame> disk <image> <drive>, image path may contain spaces
+			st.action = 5;
+			size_t a = line.find("disk") + 4;
+			size_t b = line.find_last_not_of(" \t\r");
+			size_t c = line.find_last_of(" \t", b);
+			if (c == std::string::npos || c <= a)
+				continue;
+			st.state = atoi(line.c_str() + c + 1);
+			size_t d = line.find_first_not_of(" \t", a);
+			size_t e = line.find_last_not_of(" \t", c);
+			st.arg = line.substr(d, e - d + 1);
+		} else if (!strcmp(what, "eject")) {
+			st.action = 6;
+			st.state = atoi(arg);
+		} else if (!strcmp(what, "leave")) {
+			// end the session and hard reset, netplay starts again
+			st.action = 7;
+		} else {
+			continue;
+		}
+		debug_steps.push_back(st);
+	}
+	write_log(_T("NETPLAY: %d debug script steps\n"), (int)debug_steps.size());
+}
+
+void run_debug_script(void)
+{
+	while (debug_pos < debug_steps.size() && debug_steps[debug_pos].frame <= cur_frame) {
+		npdebugstep &st = debug_steps[debug_pos++];
+		if (st.action == 0) {
+			netplay_capture_event(st.nr, st.state, 1, 0);
+		} else if (st.action == 1) {
+			TCHAR *path = au(st.arg.c_str());
+			screenshot_save(0, path);
+			xfree(path);
+		} else if (st.action == 2) {
+			uae_quit();
+		} else if (st.action == 3) {
+			netplay_request_reset(st.arg == "hard", 0);
+		} else if (st.action == 4) {
+			netplay_request_warp(st.state ? 1 : 0);
+		} else if (st.action == 5 && st.state >= 0 && st.state < NP_MAXDRIVES) {
+			// same path as a floppy change in the GUI
+			TCHAR *path = au(st.arg.c_str());
+			disk_insert(st.state, path);
+			xfree(path);
+		} else if (st.action == 6 && st.state >= 0 && st.state < NP_MAXDRIVES) {
+			disk_eject(st.state);
+		} else if (st.action == 7) {
+			netplay_stop(_T("Player left (test)."));
+			uae_reset(1, 1);
+			return;
+		}
+	}
+}
+
+void reset_session_data(void)
+{
+	for (int i = 0; i < NP_RING; i++) {
+		local_frames[i].valid = false;
+		local_frames[i].ev.clear();
+		remote_frames[i].valid = false;
+		remote_frames[i].ev.clear();
+	}
+	// first frames carry no input on either side
+	for (int i = 0; i < np_delay; i++) {
+		local_frames[i].valid = true;
+		local_frames[i].frame = i;
+		remote_frames[i].valid = true;
+		remote_frames[i].frame = i;
+	}
+	pending_local.clear();
+	play.clear();
+	play_pos = 0;
+	xfer.state = XFER_IDLE;
+	xfer.data.clear();
+	disk_table.clear();
+	disk_counter = 0;
+	local_hash.clear();
+	remote_hash.clear();
+	desync_reported = false;
+	cur_frame = 0;
+	wait_total_ms = 0;
+	wait_frames = 0;
+}
+
+void check_hashes(uae_u32 frame)
+{
+	auto l = local_hash.find(frame);
+	auto r = remote_hash.find(frame);
+	if (l == local_hash.end() || r == remote_hash.end())
+		return;
+	if (l->second != r->second && !desync_reported) {
+		desync_reported = true;
+		write_log(_T("NETPLAY: DESYNC at frame %u (local %08x remote %08x)\n"), frame, l->second, r->second);
+		statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: DESYNC at frame %u! Restart the session."), frame);
+		set_status(_T("DESYNC"));
+	}
+	// forget old entries
+	while (!local_hash.empty() && local_hash.begin()->first + 1000 < frame)
+		local_hash.erase(local_hash.begin());
+	while (!remote_hash.empty() && remote_hash.begin()->first + 1000 < frame)
+		remote_hash.erase(remote_hash.begin());
+}
+
+// partner may only send what netplay_capture_event() produces:
+// keys, joystick/mouse ports, never special actions (AKS_xxx)
+bool valid_remote_event(const npevent &e)
+{
+	if (e.flags & NPEV_SPECIAL) {
+		// only the host changes floppies, using an image player 2 has confirmed
+		if (e.state == NPSPECIAL_DISK)
+			return !is_host && e.nr < NP_MAXDRIVES && (e.max == 0 || disk_table.count((uae_u32)e.max));
+		return e.nr == 0 && e.state >= NPSPECIAL_SOFTRESET && e.state <= NPSPECIAL_WARPOFF;
+	}
+	if (e.nr == 0 || e.nr >= INPUTEVENT_END || e.nr == INPUTEVENT_SPC_CUSTOM_EVENT)
+		return false;
+	const struct inputevent *ie = inputdevice_get_eventinfo(e.nr);
+	if (!ie || !ie->name)
+		return false;
+	if (ie->unit == 0 && ie->data >= AKS_FIRST)
+		return false;
+	return true;
+}
+
+void handle_frame_msg(const npmsg &m)
+{
+	npreader r(m.data);
+	uae_u32 frame = r.u32();
+	int cnt = r.u16();
+	if (r.bad || np_state != NP_RUNNING) {
+		fail(_T("Protocol error (frame)."));
+		return;
+	}
+	if (frame < cur_frame || frame >= cur_frame + NP_RING - 1) {
+		fail(_T("Protocol error (frame number)."));
+		return;
+	}
+	npframe &f = remote_frames[frame % NP_RING];
+	f.frame = frame;
+	f.ev.clear();
+	for (int i = 0; i < cnt; i++) {
+		npevent e;
+		e.nr = r.u16();
+		e.flags = r.u8();
+		e.state = (uae_s32)r.u32();
+		e.max = (uae_s32)r.u32();
+		if (r.bad || !valid_remote_event(e)) {
+			fail(_T("Protocol error (event)."));
+			return;
+		}
+		f.ev.push_back(e);
+	}
+	f.valid = true;
+}
+
+void handle_hash_msg(const npmsg &m)
+{
+	npreader r(m.data);
+	uae_u32 frame = r.u32();
+	uae_u32 hash = r.u32();
+	if (r.bad)
+		return;
+	if (frame + NP_RING < cur_frame || frame > cur_frame + NP_RING)
+		return;
+	remote_hash[frame] = hash;
+	check_hashes(frame);
+}
+
+void queue_special(int what, int nr, int max)
+{
+	npevent e;
+	e.nr = (uae_u16)nr;
+	e.flags = NPEV_SPECIAL;
+	e.state = what;
+	e.max = max;
+	pending_local.push_back(e);
+}
+
+void xfer_done(void)
+{
+	xfer.state = XFER_IDLE;
+	xfer.data.clear();
+	xfer.data.shrink_to_fit();
+}
+
+// host: player 2 has the image, it goes into the drive on both machines in the same frame
+void xfer_ready(void)
+{
+	disk_table[xfer.id] = { xfer.path, xfer.wp };
+	queue_special(NPSPECIAL_DISK, xfer.drive, (int)xfer.id);
+	write_log(_T("NETPLAY: floppy %u ready on both machines, DF%d\n"), xfer.id, xfer.drive);
+	xfer_done();
+}
+
+// host: image data goes out a little every frame so the game keeps running
+void send_disk_chunks(void)
+{
+	if (!is_host || xfer.state != XFER_SENDING)
+		return;
+	uae_u32 budget = NP_DISKRATE;
+	while (budget > 0 && xfer.pos < xfer.size && outbuf.size() - outpos < 4 * NP_DISKRATE && sock != np_invalid) {
+		uae_u32 len = xfer.size - xfer.pos;
+		if (len > 8192)
+			len = 8192;
+		if (len > budget)
+			len = budget;
+		npbuf b;
+		b.u32(xfer.id);
+		b.u32(xfer.pos);
+		b.bytes(xfer.data.data() + xfer.pos, len);
+		send_msg(MSG_DISKCHUNK, b);
+		xfer.pos += len;
+		budget -= len;
+	}
+	if (xfer.pos >= xfer.size)
+		xfer.state = XFER_WAITREADY;
+}
+
+void handle_disk_msg(const npmsg &m)
+{
+	npreader r(m.data);
+	if (np_state != NP_RUNNING) {
+		fail(_T("Protocol error (floppy change)."));
+		return;
+	}
+	switch (m.type)
+	{
+	case MSG_DISKOFFER:
+	{
+		// player 2: host changes a floppy, use the cached copy or ask for the image
+		npdisk d;
+		uae_u32 id = r.u32();
+		int drive = r.u8();
+		bool wp = r.u8() != 0;
+		d.size = r.u32();
+		d.crc = r.u32();
+		d.name = r.str();
+		if (r.bad || is_host || id == 0 || drive >= NP_MAXDRIVES || d.size == 0 || d.size > NP_MAXDISKSIZE) {
+			fail(_T("Protocol error (floppy offer)."));
+			return;
+		}
+		TCHAR path[MAX_DPATH];
+		disk_cache_path(path, MAX_DPATH, d);
+		xfer_done();
+		xfer.id = id;
+		xfer.drive = drive;
+		xfer.wp = wp;
+		xfer.size = d.size;
+		xfer.crc = d.crc;
+		xfer.pos = 0;
+		xfer.path = path;
+		npbuf b;
+		b.u32(id);
+		if (file_crc(path, d.size, d.crc)) {
+			disk_table[id] = { xfer.path, wp };
+			b.u8(0);
+			write_log(_T("NETPLAY: floppy %u for DF%d found in cache\n"), id, drive);
+		} else {
+			xfer.data.resize(d.size);
+			xfer.state = XFER_RECEIVING;
+			b.u8(1);
+			write_log(_T("NETPLAY: receiving floppy %u for DF%d (%u bytes)\n"), id, drive, d.size);
+			statusline_add_message(STATUSTYPE_FLOPPY, _T("Netplay: receiving floppy image from player 1..."));
+		}
+		send_msg(MSG_DISKREPLY, b);
+		break;
+	}
+	case MSG_DISKCHUNK:
+	{
+		uae_u32 id = r.u32();
+		uae_u32 off = r.u32();
+		size_t len = m.data.size() - 8;
+		if (r.bad || is_host || xfer.state != XFER_RECEIVING || id != xfer.id || off != xfer.pos || off + len > xfer.size) {
+			fail(_T("Protocol error (floppy data)."));
+			return;
+		}
+		memcpy(xfer.data.data() + off, m.data.data() + 8, len);
+		xfer.pos += (uae_u32)len;
+		if (xfer.pos < xfer.size)
+			break;
+		bool ok = get_crc32(xfer.data.data(), (int)xfer.size) == xfer.crc && save_file(xfer.path.c_str(), xfer.data);
+		if (ok) {
+			disk_table[id] = { xfer.path, xfer.wp };
+			write_log(_T("NETPLAY: floppy %u received\n"), id);
+		} else {
+			write_log(_T("NETPLAY: floppy %u: cannot store %s\n"), id, xfer.path.c_str());
+			statusline_add_message(STATUSTYPE_FLOPPY, _T("Netplay: cannot store the floppy image from player 1"));
+		}
+		xfer_done();
+		npbuf b;
+		b.u32(id);
+		b.u8(ok ? 1 : 0);
+		send_msg(MSG_DISKREADY, b);
+		break;
+	}
+	case MSG_DISKREPLY:
+	{
+		// host: 0 = player 2 has the image, 1 = send it
+		uae_u32 id = r.u32();
+		int need = r.u8();
+		if (r.bad || !is_host) {
+			fail(_T("Protocol error (floppy reply)."));
+			return;
+		}
+		if (xfer.state != XFER_OFFERED || id != xfer.id)
+			break;
+		if (need) {
+			xfer.state = XFER_SENDING;
+			xfer.pos = 0;
+			write_log(_T("NETPLAY: sending floppy %u (%u bytes)\n"), id, xfer.size);
+			statusline_add_message(STATUSTYPE_FLOPPY, _T("Netplay: sending floppy image to player 2..."));
+		} else {
+			xfer_ready();
+		}
+		break;
+	}
+	case MSG_DISKREADY:
+	{
+		uae_u32 id = r.u32();
+		int ok = r.u8();
+		if (r.bad || !is_host) {
+			fail(_T("Protocol error (floppy ready)."));
+			return;
+		}
+		if (xfer.state != XFER_WAITREADY || id != xfer.id)
+			break;
+		if (ok) {
+			xfer_ready();
+		} else {
+			statusline_add_message(STATUSTYPE_FLOPPY, _T("Netplay: player 2 could not store the floppy image, floppy not changed"));
+			xfer_done();
+		}
+		break;
+	}
+	}
+}
+
+void play_disk_change(int drive, uae_u32 id)
+{
+	if (id == 0) {
+		disk_netplay_change(drive, _T(""), false);
+		return;
+	}
+	auto it = disk_table.find(id);
+	if (it == disk_table.end())
+		return;
+	disk_netplay_change(drive, it->second.path.c_str(), it->second.wp);
+}
+
+void apply_session(void)
+{
+	// same random seed on both machines, used by the reset that follows
+	currprefs.seed = changed_prefs.seed = np_seed;
+	uaesetrandseed(np_seed);
+	// host time based devices
+	currprefs.cs_rtc = changed_prefs.cs_rtc = 0;
+	currprefs.turbo_emulation = changed_prefs.turbo_emulation = 0;
+	currprefs.input_contact_bounce = changed_prefs.input_contact_bounce = 0;
+	// "synchronize clock" writes host time into the Amiga
+	currprefs.tod_hack = changed_prefs.tod_hack = false;
+	// CPU reset keeps data/address registers, a fresh emulator has zeros:
+	// the hard reset that follows must look like power-on on both machines
+	memset(regs.regs, 0, sizeof regs.regs);
+	regs.usp = regs.isp = regs.msp = 0;
+	regs.sr = 0;
+	DISK_poweron();
+	// RAM that the hard reset does not clear
+	if (custmem1_bank.baseaddr)
+		memset(custmem1_bank.baseaddr, 0, custmem1_bank.allocated_size);
+	if (custmem2_bank.baseaddr)
+		memset(custmem2_bank.baseaddr, 0, custmem2_bank.allocated_size);
+	build_remap();
+	reset_session_data();
+	session_config = config_text();
+	config_change_reported = false;
+	load_debug_script();
+	if (currprefs.netplay_debug_log[0])
+		debug_log = zfile_fopen(currprefs.netplay_debug_log, _T("w"), 0);
+	np_state = NP_RUNNING;
+	// canonical emulated port types (see inputdevice.cpp)
+	inputdevice_updateconfig(&changed_prefs, &currprefs);
+	device_add_exit(netplay_exit, NULL);
+	TCHAR tmp[256];
+	_stprintf(tmp, _T("%s, delay %d"), is_host ? _T("host") : _T("client"), np_delay);
+	set_status(tmp);
+	write_log(_T("NETPLAY: session started as %s, delay %d frames, rtt %d ms, seed %08x\n"),
+		is_host ? _T("host") : _T("client"), np_delay, rtt_ms, np_seed);
+	statusline_add_message(STATUSTYPE_OTHER, _T("Netplay started (%s), input delay %d frames"), is_host ? _T("host") : _T("client"), np_delay);
+}
+
+bool host_handshake(void)
+{
+	TCHAR tmp[2048];
+	int port = currprefs.netplay_port > 0 ? currprefs.netplay_port : NETPLAY_DEFAULT_PORT;
+	if (!host_listen(port)) {
+		_stprintf(tmp, _T("Cannot listen on TCP port %d."), port);
+		fail(tmp);
+		return false;
+	}
+	std::string addrs = local_addresses();
+	write_log(_T("NETPLAY: host listening on port %d, addresses: %s\n"), port, to_tchar(addrs).c_str());
+	if (currprefs.netplay_upnp) {
+		set_status(_T("opening the port in the router (UPnP)"));
+		upnp_open(port);
+		write_log(_T("NETPLAY: %s\n"), to_tchar(upnp_info).c_str());
+		statusline_add_message(STATUSTYPE_OTHER, _T("Netplay %s"), to_tchar(upnp_info).c_str());
+	}
+	// address for player 2: public one from the router, else LAN/VPN ones
+	std::string show = !igd.external.empty() ? igd.external : addrs;
+#ifdef _WIN32
+	_stprintf(tmp, _T("waiting for player 2: %s port %d (Esc = cancel)"), to_tchar(show).c_str(), port);
+#else
+	_stprintf(tmp, _T("waiting for player 2: %s port %d"), to_tchar(show).c_str(), port);
+#endif
+	set_status(tmp);
+
+	for (;;) {
+		// wait for a client
+		while (sock == np_invalid) {
+			struct sockaddr_storage sa;
+			socklen_t salen = sizeof sa;
+			np_socket s = accept(listener, (struct sockaddr*)&sa, &salen);
+			if (s != np_invalid) {
+				char hostname[128];
+				hostname[0] = 0;
+				getnameinfo((struct sockaddr*)&sa, salen, hostname, sizeof hostname, NULL, 0, NI_NUMERICHOST);
+				TCHAR *h = au(hostname);
+				write_log(_T("NETPLAY: connection from %s\n"), h);
+				xfree(h);
+				sock = s;
+				setup_socket(sock);
+				np_failed = false;
+				break;
+			}
+			pump_host();
+			if (user_quit()) {
+				fail(_T("Cancelled."));
+				return false;
+			}
+			sleep_millis(5);
+		}
+
+		npmsg m;
+		if (!wait_msg(MSG_HELLO, m, 10000)) {
+			// drop this client and keep waiting
+			close_sockets();
+			if (user_quit() || !host_listen(port))
+				return false;
+			np_failed = false;
+			continue;
+		}
+		npreader r(m.data);
+		uae_u32 magic = r.u32();
+		uae_u16 proto = r.u16();
+		std::string version = r.str();
+		std::string password = r.str();
+		if (r.bad || magic != NP_MAGIC || proto != NP_PROTOCOL) {
+			send_reject(_T("Different netplay protocol version, use the same WinUAE build on both machines."));
+			close_sockets();
+			if (!host_listen(port))
+				return false;
+			np_failed = false;
+			continue;
+		}
+		if (version != version_string()) {
+			TCHAR *v = utf8u(version.c_str());
+			TCHAR *mine = utf8u(version_string().c_str());
+			_stprintf(tmp, _T("Different emulator version: host %s, player 2 %s. Use the same WinUAE build."), mine, v);
+			xfree(mine);
+			xfree(v);
+			send_reject(tmp);
+			close_sockets();
+			if (!host_listen(port))
+				return false;
+			np_failed = false;
+			continue;
+		}
+		if (password != to_utf8(currprefs.netplay_password)) {
+			send_reject(_T("Wrong netplay password."));
+			close_sockets();
+			if (!host_listen(port))
+				return false;
+			np_failed = false;
+			continue;
+		}
+		// one client only
+		if (listener != np_invalid) {
+			np_closesocket(listener);
+			listener = np_invalid;
+		}
+		break;
+	}
+
+	set_status(_T("player 2 connected, measuring ping"));
+	measure_rtt();
+	if (np_failed)
+		return false;
+	if (currprefs.netplay_delay > 0) {
+		np_delay = currprefs.netplay_delay;
+	} else {
+		double frame_ms = 1000.0 / (vblank_hz > 1 ? vblank_hz : 50.0);
+		int oneway = rtt_ms < 0 ? 50 : rtt_ms / 2;
+		np_delay = (int)((oneway + 15 + frame_ms - 1) / frame_ms);
+	}
+	if (np_delay < 1)
+		np_delay = 1;
+	if (np_delay > NP_MAXDELAY)
+		np_delay = NP_MAXDELAY;
+
+	// rndseed in config makes sessions reproducible
+	np_seed = currprefs.seed ? (uae_u32)currprefs.seed : (uae_u32)time(NULL) ^ (uae_u32)now_ms() ^ 0x5a5a1234;
+	if (!np_seed)
+		np_seed = 1;
+	np_swapports = currprefs.netplay_swapports;
+	np_mouse = currprefs.netplay_mouse;
+	np_hashinterval = currprefs.netplay_debug_log[0] ? 1 : NP_HASHINTERVAL;
+
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		if (!load_disk_image(i, disks[i])) {
+			_stprintf(tmp, _T("Cannot read floppy image DF%d: %s"), i, currprefs.floppyslots[i].df);
+			send_reject(tmp);
+			fail(tmp);
+			return false;
+		}
+		// an image left in a disabled drive changes emulation, player 2 has none
+		if (!disks[i].present) {
+			currprefs.floppyslots[i].df[0] = 0;
+			changed_prefs.floppyslots[i].df[0] = 0;
+		}
+	}
+
+	npbuf b;
+	b.u32(np_seed);
+	b.u8((uae_u8)np_delay);
+	b.u8((np_swapports ? 1 : 0) | (np_mouse ? 2 : 0));
+	b.u16((uae_u16)np_hashinterval);
+	b.u16((uae_u16)(rtt_ms < 0 ? 0 : rtt_ms));
+	b.u32(rom_crc());
+	b.u8(NP_MAXDRIVES);
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		b.u8(disks[i].present ? 1 : 0);
+		b.u8(disks[i].wp ? 1 : 0);
+		b.u32(disks[i].present ? disks[i].size : 0);
+		b.u32(disks[i].present ? disks[i].crc : 0);
+		b.str(disks[i].present ? disks[i].name : std::string());
+	}
+	std::string cfg = config_text();
+	if (currprefs.netplay_debug_log[0]) {
+		TCHAR *c = utf8u(cfg.c_str());
+		write_log(_T("NETPLAY: compared configuration:\n%s"), c);
+		xfree(c);
+	}
+	b.u32((uae_u32)cfg.size());
+	b.bytes((const uae_u8*)cfg.data(), cfg.size());
+	send_msg(MSG_SETUP, b);
+
+	set_status(_T("checking configuration"));
+	npmsg m;
+	if (!wait_msg(MSG_SETUPREPLY, m, 30000))
+		return false;
+	npreader r(m.data);
+	uae_u8 ok = r.u8();
+	std::string err = r.str();
+	uae_u8 need = r.u8();
+	if (r.bad || !ok) {
+		TCHAR e[1024];
+		from_utf8(e, sizeof e / sizeof(TCHAR), err);
+		_stprintf(tmp, _T("Player 2 cannot join:\n%s"), e);
+		fail(tmp);
+		return false;
+	}
+
+	// floppy images the client does not have yet
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		if (!(need & (1 << i)) || !disks[i].present)
+			continue;
+		_stprintf(tmp, _T("sending DF%d to player 2"), i);
+		set_status(tmp);
+		for (uae_u32 off = 0; off < disks[i].size; off += NP_DISKCHUNK) {
+			uae_u32 len = disks[i].size - off;
+			if (len > NP_DISKCHUNK)
+				len = NP_DISKCHUNK;
+			npbuf d;
+			d.u8((uae_u8)i);
+			d.u32(off);
+			d.bytes(disks[i].data.data() + off, len);
+			send_msg(MSG_DISKDATA, d);
+			// do not queue megabytes, let the socket drain
+			while (outbuf.size() - outpos > 256 * 1024) {
+				if (!np_poll(10))
+					return false;
+				pump_host();
+				if (user_quit()) {
+					fail(_T("Cancelled."));
+					return false;
+				}
+			}
+		}
+	}
+	npbuf s;
+	s.u32(0);
+	send_msg(MSG_START, s);
+	set_status(_T("waiting for player 2"));
+	// client stores the images and inserts them, then both power on
+	if (!wait_msg(MSG_READY, m, 60000))
+		return false;
+	return true;
+}
+
+bool client_handshake(void)
+{
+	TCHAR tmp[1024];
+	std::string host;
+	int port;
+	if (!parse_address(currprefs.netplay_address, host, port)) {
+		fail(_T("No host address. Use netplay_address=<ip or name>[:port]."));
+		return false;
+	}
+	int attempt = 0;
+	TCHAR *hostt = au(host.c_str());
+	TCHAR hostname[256];
+	_tcsncpy(hostname, hostt, sizeof hostname / sizeof(TCHAR) - 1);
+	hostname[sizeof hostname / sizeof(TCHAR) - 1] = 0;
+	xfree(hostt);
+	while (sock == np_invalid) {
+		attempt++;
+#ifdef _WIN32
+		_stprintf(tmp, _T("connecting to %s:%d (attempt %d, Esc = cancel)"), hostname, port, attempt);
+#else
+		_stprintf(tmp, _T("connecting to %s:%d (attempt %d)"), hostname, port, attempt);
+#endif
+		set_status(tmp);
+		if (client_connect_once(host, port))
+			break;
+		if (user_quit()) {
+			fail(_T("Cancelled."));
+			return false;
+		}
+		// host may not be up yet
+		uae_s64 start = now_ms();
+		while (now_ms() - start < 1000 && !user_quit()) {
+			pump_host();
+			sleep_millis(10);
+		}
+	}
+	write_log(_T("NETPLAY: connected to %s:%d\n"), hostname, port);
+
+	npbuf b;
+	b.u32(NP_MAGIC);
+	b.u16(NP_PROTOCOL);
+	b.str(version_string());
+	b.str(to_utf8(currprefs.netplay_password));
+	send_msg(MSG_HELLO, b);
+
+	set_status(_T("connected, waiting for host"));
+	npmsg m;
+	if (!wait_msg(MSG_SETUP, m, 60000))
+		return false;
+	npreader r(m.data);
+	np_seed = r.u32();
+	np_delay = r.u8();
+	uae_u8 flags = r.u8();
+	np_hashinterval = r.u16();
+	rtt_ms = r.u16();
+	uae_u32 hostrom = r.u32();
+	int ndrives = r.u8();
+	np_swapports = (flags & 1) != 0;
+	np_mouse = (flags & 2) != 0;
+	for (int i = 0; i < ndrives && i < NP_MAXDRIVES; i++) {
+		disks[i].present = r.u8() != 0;
+		disks[i].wp = r.u8() != 0;
+		disks[i].size = r.u32();
+		disks[i].crc = r.u32();
+		disks[i].name = r.str();
+		disks[i].data.clear();
+		disks[i].received = 0;
+	}
+	uae_u32 cfglen = r.u32();
+	const uae_u8 *cfgp = r.bytes(cfglen);
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		if (disks[i].present && (disks[i].size == 0 || disks[i].size > NP_MAXDISKSIZE))
+			r.bad = true;
+	}
+	if (r.bad || np_delay < 1 || np_delay > NP_MAXDELAY || ndrives != NP_MAXDRIVES) {
+		fail(_T("Protocol error (setup)."));
+		return false;
+	}
+	if (debug_log == NULL && currprefs.netplay_debug_log[0])
+		np_hashinterval = 1;
+	std::string cfg((const char*)cfgp, cfglen);
+
+	std::string err;
+	if (rom_crc() != hostrom)
+		err += "Different Kickstart ROM. Both players need the same ROM (or both the built-in AROS ROM).\n";
+	std::string diff = compare_config(cfg);
+	if (!diff.empty())
+		err += "Different emulator configuration (use the same .uae file):\n" + diff;
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		bool used = currprefs.floppyslots[i].dfxtype >= 0;
+		if (disks[i].present && !used) {
+			err += "Floppy drive DF" + std::to_string(i) + " is disabled here but the host uses it.\n";
+		}
+	}
+
+	uae_u8 need = 0;
+	if (err.empty()) {
+		for (int i = 0; i < NP_MAXDRIVES; i++) {
+			if (!disks[i].present)
+				continue;
+			TCHAR path[MAX_DPATH];
+			disk_cache_path(path, MAX_DPATH, disks[i]);
+			if (!file_crc(path, disks[i].size, disks[i].crc)) {
+				need |= 1 << i;
+				disks[i].data.resize(disks[i].size);
+			}
+			write_log(_T("NETPLAY: DF%d %s\n"), i, (need & (1 << i)) ? _T("will be received from host") : _T("found in cache"));
+		}
+	}
+	npbuf rep;
+	rep.u8(err.empty() ? 1 : 0);
+	rep.str(err);
+	rep.u8(need);
+	send_msg(MSG_SETUPREPLY, rep);
+	if (!err.empty()) {
+		while (outpos < outbuf.size() && np_poll(10));
+		TCHAR e[2048];
+		from_utf8(e, sizeof e / sizeof(TCHAR), err);
+		fail(e);
+		return false;
+	}
+
+	// receive floppy images until START
+	set_status(need ? _T("receiving floppy images") : _T("waiting for host"));
+	for (;;) {
+		for (auto it = inbox.begin(); it != inbox.end(); ) {
+			if (it->type != MSG_DISKDATA) {
+				++it;
+				continue;
+			}
+			npreader d(it->data);
+			int drv = d.u8();
+			uae_u32 off = d.u32();
+			size_t len = it->data.size() - 5;
+			if (d.bad || drv >= NP_MAXDRIVES || !(need & (1 << drv)) || off + len > disks[drv].size) {
+				fail(_T("Protocol error (disk data)."));
+				return false;
+			}
+			memcpy(disks[drv].data.data() + off, it->data.data() + 5, len);
+			disks[drv].received += (uae_u32)len;
+			it = inbox.erase(it);
+		}
+		bool started = false;
+		for (auto it = inbox.begin(); it != inbox.end(); ++it) {
+			if (it->type == MSG_START) {
+				inbox.erase(it);
+				started = true;
+				break;
+			}
+		}
+		if (started)
+			break;
+		if (!np_poll(5))
+			return false;
+		pump_host();
+		if (user_quit()) {
+			fail(_T("Cancelled."));
+			return false;
+		}
+	}
+
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		TCHAR path[MAX_DPATH];
+		path[0] = 0;
+		if (disks[i].present) {
+			disk_cache_path(path, MAX_DPATH, disks[i]);
+			if (need & (1 << i)) {
+				if (disks[i].received != disks[i].size || get_crc32(disks[i].data.data(), (int)disks[i].size) != disks[i].crc) {
+					fail(_T("Floppy image transfer failed (checksum)."));
+					return false;
+				}
+				if (!save_file(path, disks[i].data)) {
+					_stprintf(tmp, _T("Cannot write %s"), path);
+					fail(tmp);
+					return false;
+				}
+			}
+			disks[i].data.clear();
+		}
+		// inserted by the hard reset that follows
+		_tcscpy(currprefs.floppyslots[i].df, path);
+		_tcscpy(changed_prefs.floppyslots[i].df, path);
+		currprefs.floppyslots[i].forcedwriteprotect = changed_prefs.floppyslots[i].forcedwriteprotect = disks[i].wp;
+	}
+	npbuf ready;
+	ready.u32(0);
+	send_msg(MSG_READY, ready);
+	while (outpos < outbuf.size()) {
+		if (!np_poll(10))
+			return false;
+	}
+	return true;
+}
+
+}
+
+bool netplay_active(void)
+{
+	return np_state == NP_RUNNING;
+}
+
+// netplay starts at power-on and at every hard reset outside a session
+bool netplay_pending(void)
+{
+	return currprefs.netplay_mode != NETPLAY_MODE_OFF && np_state == NP_OFF;
+}
+
+bool netplay_port_is_mouse(int port)
+{
+	return port == 0 && np_mouse;
+}
+
+bool netplay_start(void)
+{
+	TCHAR err[1024];
+
+	np_failed = false;
+	np_cancelled = false;
+	np_error[0] = 0;
+	is_host = currprefs.netplay_mode == NETPLAY_MODE_HOST;
+
+	if (!machine_check(err)) {
+		gui_message(_T("Netplay: %s"), err);
+		return false;
+	}
+	if (!start_sockets()) {
+		gui_message(_T("Netplay: network initialization failed."));
+		return false;
+	}
+	np_state = NP_HANDSHAKE;
+	pause_sound();
+	bool ok = is_host ? host_handshake() : client_handshake();
+	resume_sound();
+	if (!ok) {
+		np_state = NP_OFF;
+		close_sockets();
+		upnp_close();
+		if (np_cancelled) {
+			set_status(_T("cancelled"));
+			statusline_add_message(STATUSTYPE_OTHER, _T("Netplay cancelled, hard reset starts it again"));
+		} else {
+			set_status(_T(""));
+			if (!user_quit())
+				gui_message(_T("Netplay failed:\n%s\n\nThe game continues without netplay."), np_error);
+		}
+		return false;
+	}
+	if (listener != np_invalid) {
+		np_closesocket(listener);
+		listener = np_invalid;
+	}
+	apply_session();
+	return true;
+}
+
+void netplay_stop(const TCHAR *reason)
+{
+	if (np_state == NP_OFF)
+		return;
+	if (sock != np_invalid && !np_failed) {
+		npbuf b;
+		b.str(to_utf8(reason));
+		send_msg(MSG_BYE, b);
+		uae_s64 start = now_ms();
+		while (outpos < outbuf.size() && now_ms() - start < 500 && np_poll(10));
+	}
+	np_state = NP_OFF;
+	close_sockets();
+	upnp_close();
+	if (debug_log)
+		zfile_fclose(debug_log);
+	debug_log = NULL;
+	play.clear();
+	play_pos = 0;
+	write_log(_T("NETPLAY: stopped: %s\n"), reason);
+	write_log(_T("NETPLAY: %u frames, waited for partner %u ms in %u frames, rtt %d ms\n"),
+		cur_frame, (uae_u32)wait_total_ms, wait_frames, rtt_ms);
+	statusline_add_message(STATUSTYPE_OTHER, _T("Netplay ended: %s"), reason);
+	set_status(_T("ended"));
+}
+
+void netplay_exit(void)
+{
+	netplay_stop(_T("WinUAE was closed."));
+#ifdef _WIN32
+	if (sockets_started)
+		WSACleanup();
+#endif
+	sockets_started = false;
+}
+
+bool netplay_capture_event(int nr, int state, int max, int autofire)
+{
+	// nothing may touch the Amiga before both machines power on
+	if (np_state == NP_HANDSHAKE)
+		return true;
+	if (np_state != NP_RUNNING)
+		return false;
+	if (nr <= 0 || nr >= INPUTEVENT_END)
+		return true;
+	npevent e;
+	e.nr = (uae_u16)remap[nr];
+	e.flags = autofire ? NPEV_AUTOFIRE : 0;
+	e.state = state;
+	e.max = max;
+	pending_local.push_back(e);
+	return true;
+}
+
+bool netplay_request_reset(int hardreset, int keyboardreset)
+{
+	if (np_state != NP_RUNNING)
+		return false;
+	queue_special(hardreset ? NPSPECIAL_HARDRESET : (keyboardreset ? NPSPECIAL_KEYBOARDRESET : NPSPECIAL_SOFTRESET), 0, 0);
+	statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: reset requested"));
+	return true;
+}
+
+// warp changes emulation (automatic key release in keybuf.cpp), so both machines switch together
+bool netplay_request_warp(int mode)
+{
+	if (np_state != NP_RUNNING)
+		return false;
+	int on = mode < 0 ? !currprefs.turbo_emulation : mode > 0;
+	queue_special(on ? NPSPECIAL_WARPON : NPSPECIAL_WARPOFF, 0, 0);
+	return true;
+}
+
+// floppy insert/eject by the host goes to both machines: the image is offered
+// to player 2 (sent if not cached), then changed on both in the same frame
+bool netplay_request_disk(int num, const TCHAR *name, bool wp)
+{
+	if (np_state != NP_RUNNING)
+		return false;
+	if (!is_host) {
+		write_log(_T("NETPLAY: DF%d change refused, only the host changes floppies\n"), num);
+		statusline_add_message(STATUSTYPE_FLOPPY, _T("Netplay: only player 1 (host) can change floppies"));
+		return true;
+	}
+	if (num < 0 || num >= NP_MAXDRIVES)
+		return true;
+	if (xfer.state != XFER_IDLE) {
+		statusline_add_message(STATUSTYPE_FLOPPY, _T("Netplay: previous floppy change is still in progress"));
+		return true;
+	}
+	if (!name || !name[0]) {
+		queue_special(NPSPECIAL_DISK, num, 0);
+		return true;
+	}
+	npdisk d;
+	if (!load_image_file(name, wp, d) || d.size == 0 || d.size > NP_MAXDISKSIZE) {
+		statusline_add_message(STATUSTYPE_FLOPPY, _T("Netplay: cannot read floppy image %s"), name);
+		return true;
+	}
+	xfer_done();
+	xfer.id = ++disk_counter;
+	xfer.drive = num;
+	xfer.wp = wp;
+	xfer.size = d.size;
+	xfer.crc = d.crc;
+	xfer.pos = 0;
+	xfer.path = name;
+	xfer.data.swap(d.data);
+	xfer.state = XFER_OFFERED;
+	npbuf b;
+	b.u32(xfer.id);
+	b.u8((uae_u8)num);
+	b.u8(d.wp ? 1 : 0);
+	b.u32(d.size);
+	b.u32(d.crc);
+	b.str(d.name);
+	send_msg(MSG_DISKOFFER, b);
+	write_log(_T("NETPLAY: floppy %u offered for DF%d: %s\n"), xfer.id, num, name);
+	return true;
+}
+
+bool netplay_allow_inputcode(int code, int state)
+{
+	if (np_state != NP_RUNNING)
+		return true;
+	switch (code)
+	{
+	case AKS_FLOPPY0: case AKS_FLOPPY1: case AKS_FLOPPY2: case AKS_FLOPPY3:
+	case AKS_EFLOPPY0: case AKS_EFLOPPY1: case AKS_EFLOPPY2: case AKS_EFLOPPY3:
+	case AKS_DISKSWAPPER_INSERT0: case AKS_DISKSWAPPER_INSERT1:
+	case AKS_DISKSWAPPER_INSERT2: case AKS_DISKSWAPPER_INSERT3:
+	case AKS_DISK_PREV0: case AKS_DISK_PREV1: case AKS_DISK_PREV2: case AKS_DISK_PREV3:
+	case AKS_DISK_NEXT0: case AKS_DISK_NEXT1: case AKS_DISK_NEXT2: case AKS_DISK_NEXT3:
+		// floppy changes of the host are synchronized (netplay_request_disk)
+		if (is_host)
+			return true;
+		if (state)
+			statusline_add_message(STATUSTYPE_FLOPPY, _T("Netplay: only player 1 (host) can change floppies"));
+		return false;
+	case AKS_FREEZEBUTTON:
+	case AKS_CD0: case AKS_ECD0:
+	case AKS_IRQ7:
+	case AKS_STATEREWIND: case AKS_STATECURRENT:
+	case AKS_STATERESTOREQUICK: case AKS_STATERESTOREQUICK1: case AKS_STATERESTOREQUICK2:
+	case AKS_STATERESTOREQUICK3: case AKS_STATERESTOREQUICK4: case AKS_STATERESTOREQUICK5:
+	case AKS_STATERESTOREQUICK6: case AKS_STATERESTOREQUICK7: case AKS_STATERESTOREQUICK8:
+	case AKS_STATERESTOREQUICK9: case AKS_STATERESTOREDIALOG:
+	case AKS_RESTART:
+	case AKS_PASTE:
+	case AKS_ARCADIADIAGNOSTICS: case AKS_ARCADIAPLY1: case AKS_ARCADIAPLY2:
+	case AKS_ARCADIACOIN1: case AKS_ARCADIACOIN2:
+	case AKS_CDTV_FRONT_PANEL_STOP: case AKS_CDTV_FRONT_PANEL_PLAYPAUSE:
+	case AKS_CDTV_FRONT_PANEL_PREV: case AKS_CDTV_FRONT_PANEL_NEXT:
+	case AKS_CDTV_FRONT_PANEL_REW: case AKS_CDTV_FRONT_PANEL_FF:
+	case AKS_ALGSERVICE: case AKS_ALGLSTART: case AKS_ALGRSTART: case AKS_ALGLCOIN: case AKS_ALGRCOIN:
+	case AKS_ALGLTRIGGER: case AKS_ALGRTRIGGER: case AKS_ALGLHOLSTER: case AKS_ALGRHOLSTER:
+	case AKS_CUBOTOUCH: case AKS_CUBOTEST: case AKS_CUBOCOIN1: case AKS_CUBOCOIN2: case AKS_CUBOCOIN3: case AKS_CUBOCOIN4:
+		if (state)
+			statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: not available during a netplay session"));
+		return false;
+	}
+	return true;
+}
+
+void netplay_frame(void)
+{
+	if (np_state != NP_RUNNING)
+		return;
+
+	if (debug_pos < debug_steps.size()) {
+		run_debug_script();
+		if (np_state != NP_RUNNING)
+			return;
+	}
+
+	// local input of this frame is applied delay frames later on both machines
+	uae_u32 target = cur_frame + np_delay;
+	npframe &lf = local_frames[target % NP_RING];
+	lf.frame = target;
+	lf.valid = true;
+	lf.ev.swap(pending_local);
+	pending_local.clear();
+	npbuf b;
+	b.u32(target);
+	b.u16((uae_u16)lf.ev.size());
+	for (auto &e : lf.ev) {
+		b.u16(e.nr);
+		b.u8(e.flags);
+		b.u32((uae_u32)e.state);
+		b.u32((uae_u32)e.max);
+	}
+	send_msg(MSG_FRAME, b);
+	send_disk_chunks();
+	if (np_failed) {
+		netplay_stop(np_error);
+		return;
+	}
+	np_poll(0);
+
+	npframe &rf = remote_frames[cur_frame % NP_RING];
+	if (!(rf.valid && rf.frame == cur_frame)) {
+		uae_s64 start = now_ms();
+		bool slow = false;
+		while (!(rf.valid && rf.frame == cur_frame)) {
+			if (!np_poll(2)) {
+				netplay_stop(np_error[0] ? np_error : _T("Connection lost."));
+				return;
+			}
+			pump_host();
+			if (user_quit()) {
+				netplay_stop(_T("WinUAE was closed."));
+				return;
+			}
+			if (!slow && now_ms() - start > 1000) {
+				slow = true;
+				pause_sound();
+				set_status(_T("waiting for partner..."));
+				statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: waiting for partner..."));
+			}
+		}
+		uae_s64 waited = now_ms() - start;
+		wait_total_ms += waited;
+		wait_frames++;
+		if (slow) {
+			resume_sound();
+			TCHAR tmp[256];
+			_stprintf(tmp, _T("%s, delay %d"), is_host ? _T("host") : _T("client"), np_delay);
+			set_status(tmp);
+		}
+	}
+
+	// identical state on both machines at this point
+	if (np_hashinterval > 0 && (cur_frame % np_hashinterval) == 0) {
+		uae_u32 h = state_hash();
+		local_hash[cur_frame] = h;
+		npbuf hb;
+		hb.u32(cur_frame);
+		hb.u32(h);
+		send_msg(MSG_HASH, hb);
+		if (debug_log) {
+			char line[64];
+			sprintf(line, "%u %08x\n", cur_frame, h);
+			zfile_fwrite(line, 1, strlen(line), debug_log);
+		}
+		check_hashes(cur_frame);
+	}
+	if (cur_frame > 0 && (cur_frame % 250) == 0)
+		send_ping((cur_frame / 250) & 15);
+	// settings changed in the GUI on one machine break the session
+	if ((cur_frame % 250) == 125 && !config_change_reported) {
+		std::string diff = compare_config(session_config);
+		if (!diff.empty()) {
+			config_change_reported = true;
+			TCHAR *d = utf8u(diff.c_str());
+			write_log(_T("NETPLAY: configuration changed during the session:\n%s"), d);
+			xfree(d);
+			statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: emulator settings changed during the session, the game may desync"));
+		}
+	}
+
+	// host input first, then client input
+	npframe &mine = local_frames[cur_frame % NP_RING];
+	npframe &first = is_host ? mine : rf;
+	npframe &second = is_host ? rf : mine;
+	play.clear();
+	play_pos = 0;
+	play.insert(play.end(), first.ev.begin(), first.ev.end());
+	play.insert(play.end(), second.ev.begin(), second.ev.end());
+	mine.valid = false;
+	mine.ev.clear();
+	rf.valid = false;
+	rf.ev.clear();
+	cur_frame++;
+}
+
+bool netplay_playevent(int *nr, int *state, int *max, int *autofire)
+{
+	while (play_pos < play.size()) {
+		npevent &e = play[play_pos++];
+		if (e.flags & NPEV_SPECIAL) {
+			switch (e.state)
+			{
+			case NPSPECIAL_SOFTRESET:
+				uae_reset(0, 0);
+				break;
+			case NPSPECIAL_HARDRESET:
+				uae_reset(1, 1);
+				break;
+			case NPSPECIAL_KEYBOARDRESET:
+				uae_reset(0, 1);
+				break;
+			case NPSPECIAL_WARPON:
+				warpmode(1);
+				break;
+			case NPSPECIAL_WARPOFF:
+				warpmode(0);
+				break;
+			case NPSPECIAL_DISK:
+				play_disk_change(e.nr, (uae_u32)e.max);
+				break;
+			}
+			continue;
+		}
+		*nr = e.nr;
+		*state = e.state;
+		*max = e.max;
+		*autofire = (e.flags & NPEV_AUTOFIRE) ? 1 : 0;
+		return true;
+	}
+	return false;
+}
+
+// text for the netplay page of the GUI
+void netplay_getinfo(TCHAR *out, int maxlen)
+{
+	std::basic_string<TCHAR> s;
+	TCHAR tmp[800];
+	tmp[0] = 0;
+	if (np_state == NP_RUNNING) {
+		_stprintf(tmp, _T("Session running as %s, input delay %d frames, ping %d ms."), is_host ? _T("host") : _T("player 2"), np_delay, rtt_ms);
+	} else if (np_error[0]) {
+		_stprintf(tmp, _T("Not connected. Last session: %s"), np_error);
+	} else {
+		_tcscpy(tmp, _T("Not connected. Netplay starts with Start or a hard reset."));
+	}
+	s += tmp;
+	std::string a = local_addresses();
+	if (!a.empty())
+		s += _T("\nThis computer: ") + to_tchar(a);
+	if (!upnp_info.empty())
+		s += _T("\n") + to_tchar(upnp_info);
+	_tcsncpy(out, s.c_str(), maxlen - 1);
+	out[maxlen - 1] = 0;
+}
+
+void netplay_getstatus(TCHAR *out)
+{
+	if (!np_status[0] || currprefs.netplay_mode == NETPLAY_MODE_OFF)
+		return;
+	TCHAR tmp[400];
+	if (np_state == NP_RUNNING && rtt_ms >= 0)
+		_stprintf(tmp, _T("[Netplay %s, %d ms] "), np_status, rtt_ms);
+	else
+		_stprintf(tmp, _T("[Netplay: %s] "), np_status);
+	_tcscat(out, tmp);
+}
