+void measure_rtt(void)
+{
+	rtt_ms = -1;
+	for (int i = 0; i < 8 && !np_failed; i++) {
+		int old = pongs;
+		send_ping(i);
+		uae_s64 start = now_ms();
+		while (pongs == old && now_ms() - start < 2000) {
+			if (!np_poll(5))
+				return;
+			pump_host();
+		}
+	}
