+std::string lowercase(std::string s)
+{
+	for (auto &c : s)
+		c = (char)tolower((unsigned char)c);
+	return s;
+}
+
+std::string xml_value(const std::string &xml, const char *tag)
+{
+	std::string open = std::string("<") + tag + ">";
+	std::string close = std::string("</") + tag + ">";
+	size_t a = xml.find(open);
+	if (a == std::string::npos)
+		return std::string();
+	a += open.size();
+	size_t b = xml.find(close, a);
+	if (b == std::string::npos)
+		return std::string();
+	std::string v = xml.substr(a, b - a);
+	size_t f = v.find_first_not_of(" \t\r\n");
+	size_t l = v.find_last_not_of(" \t\r\n");
+	return f == std::string::npos ? std::string() : v.substr(f, l - f + 1);
+}
+
+bool parse_url(const std::string &url, std::string &host, int &port, std::string &path)
+{
+	if (lowercase(url.substr(0, 7)) != "http://")
+		return false;
+	size_t pe = url.find('/', 7);
+	std::string hp = url.substr(7, pe == std::string::npos ? std::string::npos : pe - 7);
+	path = pe == std::string::npos ? "/" : url.substr(pe);
+	port = 80;
+	size_t c = hp.find(':');
+	if (c != std::string::npos) {
+		port = atoi(hp.c_str() + c + 1);
+		hp = hp.substr(0, c);
+	}
+	host = hp;
+	return !host.empty() && port > 0 && port < 65536;
+}
+
+bool resolve4(const std::string &host, int port, struct sockaddr_in &sa)
+{
+	struct addrinfo hints, *res = NULL;
+	memset(&hints, 0, sizeof hints);
+	hints.ai_family = AF_INET;
+	char ps[16];
+	sprintf(ps, "%d", port);
+	if (getaddrinfo(host.c_str(), ps, &hints, &res) || !res)
+		return false;
+	memcpy(&sa, res->ai_addr, sizeof sa);
+	freeaddrinfo(res);
+	return true;
+}
+
+// small HTTP/1.1 client, returns status and (de-chunked) body
+bool http_request(const std::string &host, int port, const std::string &req, int &status, std::string &body, int timeout_ms)
+{
+	struct sockaddr_in sa;
+	if (!resolve4(host, port, sa))
+		return false;
+	np_socket s = socket(AF_INET, SOCK_STREAM, 0);
+	if (s == np_invalid)
+		return false;
+	np_nonblocking(s);
+	connect(s, (struct sockaddr*)&sa, sizeof sa);
+	std::string resp;
+	size_t sent = 0;
+	bool closed = false;
+	uae_s64 start = now_ms();
+	while (now_ms() - start < timeout_ms && !closed) {
+		fd_set rfds, wfds;
+		FD_ZERO(&rfds);
+		FD_ZERO(&wfds);
+		if (sent < req.size())
+			FD_SET(s, &wfds);
+		else
+			FD_SET(s, &rfds);
+		struct timeval tv;
+		tv.tv_sec = 0;
+		tv.tv_usec = 20000;
+		int n = select((int)s + 1, &rfds, &wfds, NULL, &tv);
+		pump_host();
+		if (n < 0 && !np_wouldblock())
+			break;
+		if (n <= 0)
+			continue;
+		if (sent < req.size()) {
+			int w = (int)send(s, req.data() + sent, (int)(req.size() - sent), 0);
+			if (w > 0)
+				sent += w;
+			else if (!np_wouldblock())
+				break;
+		} else {
+			char buf[4096];
+			int r = (int)recv(s, buf, sizeof buf, 0);
+			if (r > 0) {
+				resp.append(buf, r);
+				if (resp.size() > 512 * 1024)
+					break;
+			} else if (r == 0 || !np_wouldblock()) {
+				closed = true;
+			}
+		}
+	}
+	np_closesocket(s);
+	size_t he = resp.find("\r\n\r\n");
+	if (he == std::string::npos || resp.compare(0, 5, "HTTP/") != 0)
+		return false;
+	size_t sp = resp.find(' ');
+	status = atoi(resp.c_str() + sp + 1);
+	std::string head = lowercase(resp.substr(0, he));
+	body = resp.substr(he + 4);
+	if (head.find("transfer-encoding: chunked") != std::string::npos) {
+		std::string out;
+		size_t pos = 0;
+		for (;;) {
+			size_t le = body.find("\r\n", pos);
+			if (le == std::string::npos)
+				break;
+			unsigned long len = strtoul(body.c_str() + pos, NULL, 16);
+			pos = le + 2;
+			if (len == 0 || len > body.size() - pos)
+				break;
+			out.append(body, pos, len);
+			pos += len + 2;
+		}
+		body = out;
+	}
+	return true;
+}
+
+// LOCATION urls of gateways that answered the SSDP search
+std::vector<std::string> ssdp_discover(int timeout_ms)
+{
+	std::vector<std::string> found;
+	np_socket s = socket(AF_INET, SOCK_DGRAM, 0);
+	if (s == np_invalid)
+		return found;
+	np_nonblocking(s);
+	int ttl = 2;
+	setsockopt(s, IPPROTO_IP, IP_MULTICAST_TTL, (const char*)&ttl, sizeof ttl);
+	struct sockaddr_in to;
+	memset(&to, 0, sizeof to);
+	to.sin_family = AF_INET;
+	to.sin_port = htons(1900);
+	inet_pton(AF_INET, "239.255.255.250", &to.sin_addr);
+	static const char *targets[] = {
+		"urn:schemas-upnp-org:device:InternetGatewayDevice:1",
+		"urn:schemas-upnp-org:device:InternetGatewayDevice:2",
+		"urn:schemas-upnp-org:service:WANIPConnection:1",
+		"urn:schemas-upnp-org:service:WANPPPConnection:1",
+		NULL
+	};
+	for (int i = 0; targets[i]; i++) {
+		char msg[512];
+		sprintf(msg, "M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\nMX: 2\r\nST: %s\r\n\r\n", targets[i]);
+		sendto(s, msg, (int)strlen(msg), 0, (struct sockaddr*)&to, sizeof to);
+	}
+	uae_s64 start = now_ms(), first = 0;
+	while (now_ms() - start < timeout_ms && (!first || now_ms() - first < 300)) {
+		fd_set rfds;
+		FD_ZERO(&rfds);
+		FD_SET(s, &rfds);
+		struct timeval tv;
+		tv.tv_sec = 0;
+		tv.tv_usec = 20000;
+		int n = select((int)s + 1, &rfds, NULL, NULL, &tv);
+		pump_host();
+		if (n <= 0)
+			continue;
+		char buf[2048];
+		int r = (int)recvfrom(s, buf, sizeof buf - 1, 0, NULL, NULL);
+		if (r <= 0)
+			continue;
+		buf[r] = 0;
+		std::string resp(buf);
+		std::string low = lowercase(resp);
+		size_t l = low.find("\nlocation:");
+		if (l == std::string::npos)
+			continue;
+		l += 10;
+		size_t e = resp.find("\r", l);
+		std::string loc = resp.substr(l, e == std::string::npos ? std::string::npos : e - l);
+		size_t f = loc.find_first_not_of(" \t");
+		if (f == std::string::npos)
+			continue;
+		loc = loc.substr(f);
+		if (std::find(found.begin(), found.end(), loc) == found.end())
+			found.push_back(loc);
+		if (!first)
+			first = now_ms();
+	}
+	np_closesocket(s);
+	return found;
+}
+
+// read the gateway's description, find its WAN connection service
+bool igd_from_location(const std::string &location)
+{
+	std::string host, path, body;
+	int port, status;
+	if (!parse_url(location, host, port, path))
+		return false;
+	std::string req = "GET " + path + " HTTP/1.1\r\nHost: " + host + ":" + std::to_string(port) + "\r\nConnection: close\r\n\r\n";
+	if (!http_request(host, port, req, status, body, 3000) || status != 200)
+		return false;
+	std::string control, service;
+	size_t pos = 0;
+	while ((pos = body.find("<service>", pos)) != std::string::npos) {
+		size_t end = body.find("</service>", pos);
+		if (end == std::string::npos)
+			break;
+		std::string block = body.substr(pos, end - pos);
+		std::string type = xml_value(block, "serviceType");
+		bool ip = type.find(":WANIPConnection:") != std::string::npos;
+		if ((ip || type.find(":WANPPPConnection:") != std::string::npos) && (control.empty() || ip)) {
+			control = xml_value(block, "controlURL");
+			service = type;
+		}
+		pos = end;
+	}
+	if (control.empty())
+		return false;
+	std::string base = xml_value(body, "URLBase");
+	if (base.empty())
+		base = location;
+	std::string chost, cpath;
+	int cport;
+	if (lowercase(control.substr(0, 7)) == "http://") {
+		if (!parse_url(control, chost, cport, cpath))
+			return false;
+	} else {
+		if (!parse_url(base, chost, cport, cpath))
+			return false;
+		cpath = control[0] == '/' ? control : "/" + control;
+	}
+	igd.host = chost;
+	igd.port = cport;
+	igd.control = cpath;
+	igd.service = service;
+	// our address as seen from the router
+	struct sockaddr_in sa, me;
+	if (!resolve4(chost, cport, sa))
+		return false;
+	np_socket s = socket(AF_INET, SOCK_DGRAM, 0);
+	if (s == np_invalid)
+		return false;
+	socklen_t len = sizeof me;
+	bool ok = connect(s, (struct sockaddr*)&sa, sizeof sa) == 0 && getsockname(s, (struct sockaddr*)&me, &len) == 0;
+	np_closesocket(s);
+	if (!ok)
+		return false;
+	char ip[64];
+	if (!inet_ntop(AF_INET, &me.sin_addr, ip, sizeof ip))
+		return false;
+	igd.localip = ip;
+	return true;
+}
+
+bool soap(const char *action, const std::string &args, int &status, std::string &body)
+{
+	std::string env = "<?xml version=\"1.0\"?>\r\n<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"><s:Body><u:";
+	env += std::string(action) + " xmlns:u=\"" + igd.service + "\">" + args + "</u:" + action + "></s:Body></s:Envelope>\r\n";
+	std::string req = "POST " + igd.control + " HTTP/1.1\r\nHost: " + igd.host + ":" + std::to_string(igd.port) + "\r\n";
+	req += "Content-Type: text/xml; charset=\"utf-8\"\r\nSOAPAction: \"" + igd.service + "#" + action + "\"\r\n";
+	req += "Content-Length: " + std::to_string(env.size()) + "\r\nConnection: close\r\n\r\n" + env;
+	return http_request(igd.host, igd.port, req, status, body, 3000);
+}
+
+bool upnp_add(int port, int lease, int &status, std::string &body)
+{
+	std::string p = std::to_string(port);
+	std::string args = "<NewRemoteHost></NewRemoteHost><NewExternalPort>" + p + "</NewExternalPort><NewProtocol>TCP</NewProtocol>"
+		"<NewInternalPort>" + p + "</NewInternalPort><NewInternalClient>" + igd.localip + "</NewInternalClient>"
+		"<NewEnabled>1</NewEnabled><NewPortMappingDescription>WinUAE netplay</NewPortMappingDescription>"
+		"<NewLeaseDuration>" + std::to_string(lease) + "</NewLeaseDuration>";
+	return soap("AddPortMapping", args, status, body);
+}
+
+void upnp_open(int port)
+{
+	igd = npigd();
+	upnp_info.clear();
+	std::vector<std::string> locs = ssdp_discover(2500);
+	bool found = false;
+	for (auto &l : locs) {
+		if (igd_from_location(l)) {
+			found = true;
+			break;
+		}
+	}
+	char tmp[512];
+	if (!found) {
+		sprintf(tmp, "UPnP: no router answered. Forward TCP port %d to this computer or use a VPN.", port);
+		upnp_info = tmp;
+		return;
+	}
+	int status = 0;
+	std::string body;
+	// limited lease so a crashed session does not leave the port open,
+	// some routers only accept permanent mappings (error 725)
+	bool ok = upnp_add(port, 7200, status, body) && status == 200;
+	if (!ok && xml_value(body, "errorCode") == "725")
+		ok = upnp_add(port, 0, status, body) && status == 200;
+	if (!ok && xml_value(body, "errorCode") == "718") {
+		// already forwarded: fine if it points to this computer
+		std::string p = std::to_string(port);
+		std::string b2;
+		int st2 = 0;
+		if (soap("GetSpecificPortMappingEntry", "<NewRemoteHost></NewRemoteHost><NewExternalPort>" + p + "</NewExternalPort><NewProtocol>TCP</NewProtocol>", st2, b2)
+			&& st2 == 200 && xml_value(b2, "NewInternalClient") == igd.localip)
+			ok = true;
+	}
+	if (ok) {
+		igd.mapped = port;
+		std::string b3;
+		int st3 = 0;
+		if (soap("GetExternalIPAddress", "", st3, b3) && st3 == 200)
+			igd.external = xml_value(b3, "NewExternalIPAddress");
+		sprintf(tmp, "UPnP: router forwards TCP port %d to %s", port, igd.localip.c_str());
+		upnp_info = tmp;
+		if (!igd.external.empty())
+			upnp_info += ", public address " + igd.external;
+	} else {
+		std::string code = xml_value(body, "errorCode");
+		sprintf(tmp, "UPnP: router refused to forward TCP port %d (%s). Forward it manually or use a VPN.", port, code.empty() ? std::to_string(status).c_str() : code.c_str());
+		upnp_info = tmp;
+	}
+}
+
+void upnp_close(void)
+{
+	if (!igd.mapped)
+		return;
+	std::string p = std::to_string(igd.mapped);
+	std::string body;
+	int status = 0;
+	soap("DeletePortMapping", "<NewRemoteHost></NewRemoteHost><NewExternalPort>" + p + "</NewExternalPort><NewProtocol>TCP</NewProtocol>", status, body);
+	write_log(_T("NETPLAY: UPnP port %d closed (%d)\n"), igd.mapped, status);
+	igd.mapped = 0;
+}
