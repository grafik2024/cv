+void close_sockets(void)
+{
+	if (sock != np_invalid)
+		np_closesocket(sock);
+	sock = np_invalid;
+	if (listener != np_invalid)
+		np_closesocket(listener);
+	listener = np_invalid;
+	inbuf.clear();
+	outbuf.clear();
+	outpos = 0;
+	inbox.clear();
+}
