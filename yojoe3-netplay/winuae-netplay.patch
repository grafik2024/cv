+bool load_disk_image(int num, npdisk &d)
+{
+	d.present = false;
+	d.data.clear();
+	const TCHAR *df = currprefs.floppyslots[num].df;
+	if (!df[0] || currprefs.floppyslots[num].dfxtype < 0)
+		return true;
+	struct zfile *f = zfile_fopen(df, _T("rb"), ZFD_NORMAL);
+	if (!f)
+		return false;
+	int len = 0;
+	uae_u8 *data = zfile_getdata(f, 0, -1, &len);
+	const TCHAR *name = zfile_getfilename(f);
+	d.name = to_utf8(basename_of(name && name[0] ? name : df));
+	zfile_fclose(f);
+	if (!data)
+		return false;
+	d.data.assign(data, data + len);
+	xfree(data);
+	d.present = true;
+	d.size = (uae_u32)d.data.size();
+	d.crc = get_crc32(d.data.data(), (int)d.data.size());
+	d.wp = currprefs.floppyslots[num].forcedwriteprotect;
+	return true;
+}
+
+// create missing directories of a path ending with a separator
+void make_dirs(const TCHAR *path)
+{
+	TCHAR tmp[MAX_DPATH];
+	_tcsncpy(tmp, path, MAX_DPATH - 1);
+	tmp[MAX_DPATH - 1] = 0;
+	for (TCHAR *p = tmp + 1; *p; p++) {
+		if (*p != '/' && *p != '\\')
+			continue;
+		TCHAR c = *p;
+		*p = 0;
+		if (tmp[0] && tmp[_tcslen(tmp) - 1] != ':' && !my_existsdir(tmp))
+			my_mkdir(tmp);
+		*p = c;
+	}
+}
+
+void disk_cache_path(TCHAR *out, int size, const npdisk &d)
+{
+	TCHAR name[MAX_DPATH];
+	fetch_saveimagepath(out, size, 1);
+	int l = uaetcslen(out);
+	if (l > 0 && out[l - 1] != '/' && out[l - 1] != '\\') {
+		out[l++] = FSDB_DIR_SEPARATOR;
+		out[l] = 0;
+	}
+	make_dirs(out);
+	from_utf8(name, sizeof name / sizeof(TCHAR), d.name);
+	// strip anything that could escape the directory
+	for (TCHAR *p = name; *p; p++) {
+		if (*p == '/' || *p == '\\' || *p == ':')
+			*p = '_';
+	}
+	_stprintf(out + l, _T("netplay_%08x_%s"), d.crc, name);
+}
+
+bool file_crc(const TCHAR *path, uae_u32 size, uae_u32 crc)
+{
+	struct zfile *f = zfile_fopen(path, _T("rb"), 0);
+	if (!f)
+		return false;
+	int len = 0;
+	uae_u8 *data = zfile_getdata(f, 0, -1, &len);
+	zfile_fclose(f);
+	bool ok = data && (uae_u32)len == size && get_crc32(data, len) == crc;
+	xfree(data);
+	return ok;
+}
+
+bool save_file(const TCHAR *path, const std::vector<uae_u8> &data)
+{
+	struct zfile *f = zfile_fopen(path, _T("wb"), 0);
+	if (!f)
+		return false;
+	bool ok = zfile_fwrite(data.data(), 1, data.size(), f) == data.size();
+	zfile_fclose(f);
+	return ok;
+}
+
+bool machine_check(TCHAR *err)
+{
+	if (currprefs.m68k_speed < 0) {
+		_tcscpy(err, _T("CPU speed \"Fastest possible\" depends on host speed and cannot be synchronized. Use \"Approximate A500/A1200 or cycle-exact\" CPU speed."));
+		return false;
+	}
+	if (currprefs.cachesize) {
+		_tcscpy(err, _T("JIT is not supported in netplay."));
+		return false;
+	}
+	if (currprefs.cpu_thread) {
+		_tcscpy(err, _T("Threaded CPU is not supported in netplay."));
+		return false;
+	}
+	if (savestate_state == STATE_DORESTORE || savestate_state == STATE_RESTORE) {
+		_tcscpy(err, _T("Netplay always starts from power-on, state files cannot be loaded at startup."));
+		return false;
+	}
+	return true;
+}
+
+void build_remap(void)
+{
+	for (int i = 0; i < INPUTEVENT_END; i++)
+		remap[i] = i;
+	if (is_host || !np_swapports)
+		return;
+	// client's joystick port events move to the mouse port
+	for (int i = 1; i < INPUTEVENT_END; i++) {
+		const struct inputevent *ie = inputdevice_get_eventinfo(i);
+		if (!ie || !ie->name || ie->unit != 2 || !ie->portid)
+			continue;
+		for (int j = 1; j < INPUTEVENT_END; j++) {
+			const struct inputevent *ie2 = inputdevice_get_eventinfo(j);
+			if (ie2 && ie2->name && ie2->unit == 1 && ie2->portid == ie->portid && ie2->type == ie->type) {
+				remap[i] = j;
+				break;
+			}
+		}
+	}
+}
+
+void load_debug_script(void)
+{
+	debug_steps.clear();
+	debug_pos = 0;
+	if (!currprefs.netplay_debug_input[0])
+		return;
+	struct zfile *f = zfile_fopen(currprefs.netplay_debug_input, _T("rb"), 0);
+	if (!f)
+		return;
+	int len = 0;
+	uae_u8 *data = zfile_getdata(f, 0, -1, &len);
+	zfile_fclose(f);
+	if (!data)
+		return;
+	std::string s((const char*)data, len);
+	xfree(data);
+	size_t pos = 0;
+	while (pos < s.size()) {
+		size_t e = s.find('\n', pos);
+		if (e == std::string::npos)
+			e = s.size();
+		std::string line = s.substr(pos, e - pos);
+		pos = e + 1;
+		char what[64], arg[256];
+		unsigned int frame;
+		int state = 0;
+		arg[0] = 0;
+		if (line.empty() || line[0] == '#' || sscanf(line.c_str(), "%u %63s %255s %d", &frame, what, arg, &state) < 2)
+			continue;
+		npdebugstep st;
+		st.frame = frame;
+		st.nr = 0;
+		st.state = state;
+		st.arg = arg;
+		if (!strcmp(what, "event")) {
+			st.action = 0;
+			TCHAR *name = au(arg);
+			for (int i = 1; i < INPUTEVENT_END; i++) {
+				const struct inputevent *ie = inputdevice_get_eventinfo(i);
+				if (ie && ie->confname && !_tcsicmp(ie->confname, name)) {
+					st.nr = i;
+					break;
+				}
+			}
+			xfree(name);
+			if (!st.nr) {
+				TCHAR *l = au(line.c_str());
+				write_log(_T("NETPLAY: debug script, unknown event '%s'\n"), l);
+				xfree(l);
+				continue;
+			}
+		} else if (!strcmp(what, "shot")) {
+			st.action = 1;
+		} else if (!strcmp(what, "quit")) {
+			st.action = 2;
+		} else if (!strcmp(what, "reset")) {
+			st.action = 3;
+		} else {
+			continue;
+		}
+		debug_steps.push_back(st);
+	}
+	write_log(_T("NETPLAY: %d debug script steps\n"), (int)debug_steps.size());
+}
+
+void run_debug_script(void)
+{
+	while (debug_pos < debug_steps.size() && debug_steps[debug_pos].frame <= cur_frame) {
+		npdebugstep &st = debug_steps[debug_pos++];
+		if (st.action == 0) {
+			netplay_capture_event(st.nr, st.state, 1, 0);
+		} else if (st.action == 1) {
+			TCHAR *path = au(st.arg.c_str());
+			screenshot_save(0, path);
+			xfree(path);
+		} else if (st.action == 2) {
+			uae_quit();
+		} else if (st.action == 3) {
+			netplay_request_reset(st.arg == "hard", 0);
+		}
+	}
+}
+
+void reset_session_data(void)
+{
+	for (int i = 0; i < NP_RING; i++) {
+		local_frames[i].valid = false;
+		local_frames[i].ev.clear();
+		remote_frames[i].valid = false;
+		remote_frames[i].ev.clear();
+	}
+	// first frames carry no input on either side
+	for (int i = 0; i < np_delay; i++) {
+		local_frames[i].valid = true;
+		local_frames[i].frame = i;
+		remote_frames[i].valid = true;
+		remote_frames[i].frame = i;
+	}
+	pending_local.clear();
+	play.clear();
+	play_pos = 0;
+	local_hash.clear();
+	remote_hash.clear();
+	desync_reported = false;
+	cur_frame = 0;
+	wait_total_ms = 0;
+	wait_frames = 0;
+}
+
+void check_hashes(uae_u32 frame)
+{
+	auto l = local_hash.find(frame);
+	auto r = remote_hash.find(frame);
+	if (l == local_hash.end() || r == remote_hash.end())
+		return;
+	if (l->second != r->second && !desync_reported) {
+		desync_reported = true;
+		write_log(_T("NETPLAY: DESYNC at frame %u (local %08x remote %08x)\n"), frame, l->second, r->second);
+		statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: DESYNC at frame %u! Restart the session."), frame);
+		set_status(_T("DESYNC"));
+	}
+	// forget old entries
+	while (!local_hash.empty() && local_hash.begin()->first + 1000 < frame)
+		local_hash.erase(local_hash.begin());
+	while (!remote_hash.empty() && remote_hash.begin()->first + 1000 < frame)
+		remote_hash.erase(remote_hash.begin());
+}
+
+// partner may only send what netplay_capture_event() produces:
+// keys, joystick/mouse ports, never special actions (AKS_xxx)
+bool valid_remote_event(const npevent &e)
+{
+	if (e.flags & NPEV_SPECIAL)
+		return e.nr == 0 && e.state >= NPSPECIAL_SOFTRESET && e.state <= NPSPECIAL_KEYBOARDRESET;
+	if (e.nr == 0 || e.nr >= INPUTEVENT_END || e.nr == INPUTEVENT_SPC_CUSTOM_EVENT)
+		return false;
+	const struct inputevent *ie = inputdevice_get_eventinfo(e.nr);
+	if (!ie || !ie->name)
+		return false;
+	if (ie->unit == 0 && ie->data >= AKS_FIRST)
+		return false;
+	return true;
+}
+
+void handle_frame_msg(const npmsg &m)
+{
+	npreader r(m.data);
+	uae_u32 frame = r.u32();
+	int cnt = r.u16();
+	if (r.bad || np_state != NP_RUNNING) {
+		fail(_T("Protocol error (frame)."));
+		return;
+	}
+	if (frame < cur_frame || frame >= cur_frame + NP_RING - 1) {
+		fail(_T("Protocol error (frame number)."));
+		return;
+	}
+	npframe &f = remote_frames[frame % NP_RING];
+	f.frame = frame;
+	f.ev.clear();
+	for (int i = 0; i < cnt; i++) {
+		npevent e;
+		e.nr = r.u16();
+		e.flags = r.u8();
+		e.state = (uae_s32)r.u32();
+		e.max = (uae_s32)r.u32();
+		if (r.bad || !valid_remote_event(e)) {
+			fail(_T("Protocol error (event)."));
+			return;
+		}
+		f.ev.push_back(e);
+	}
+	f.valid = true;
+}
+
+void handle_hash_msg(const npmsg &m)
+{
+	npreader r(m.data);
+	uae_u32 frame = r.u32();
+	uae_u32 hash = r.u32();
+	if (r.bad)
+		return;
+	if (frame + NP_RING < cur_frame || frame > cur_frame + NP_RING)
+		return;
+	remote_hash[frame] = hash;
+	check_hashes(frame);
+}
+
+void apply_session(void)
+{
+	// same random seed on both machines, used by the reset that follows
+	currprefs.seed = changed_prefs.seed = np_seed;
+	uaesetrandseed(np_seed);
+	// host time based devices
+	currprefs.cs_rtc = changed_prefs.cs_rtc = 0;
+	currprefs.turbo_emulation = changed_prefs.turbo_emulation = 0;
+	currprefs.input_contact_bounce = changed_prefs.input_contact_bounce = 0;
+	build_remap();
+	reset_session_data();
+	session_config = config_text();
+	config_change_reported = false;
+	load_debug_script();
+	if (currprefs.netplay_debug_log[0])
+		debug_log = zfile_fopen(currprefs.netplay_debug_log, _T("w"), 0);
+	np_state = NP_RUNNING;
+	// canonical emulated port types (see inputdevice.cpp)
+	inputdevice_updateconfig(&changed_prefs, &currprefs);
+	device_add_exit(netplay_exit, NULL);
+	TCHAR tmp[256];
+	_stprintf(tmp, _T("%s, delay %d"), is_host ? _T("host") : _T("client"), np_delay);
+	set_status(tmp);
+	write_log(_T("NETPLAY: session started as %s, delay %d frames, rtt %d ms, seed %08x\n"),
+		is_host ? _T("host") : _T("client"), np_delay, rtt_ms, np_seed);
+	statusline_add_message(STATUSTYPE_OTHER, _T("Netplay started (%s), input delay %d frames"), is_host ? _T("host") : _T("client"), np_delay);
+}
+
+bool host_handshake(void)
+{
+	TCHAR tmp[2048];
+	int port = currprefs.netplay_port > 0 ? currprefs.netplay_port : NETPLAY_DEFAULT_PORT;
+	if (!host_listen(port)) {
+		_stprintf(tmp, _T("Cannot listen on TCP port %d."), port);
+		fail(tmp);
+		return false;
+	}
+	_stprintf(tmp, _T("waiting for player 2 on port %d"), port);
+	set_status(tmp);
+	write_log(_T("NETPLAY: host listening on port %d\n"), port);
+
+	for (;;) {
+		// wait for a client
+		while (sock == np_invalid) {
+			struct sockaddr_storage sa;
+			socklen_t salen = sizeof sa;
+			np_socket s = accept(listener, (struct sockaddr*)&sa, &salen);
+			if (s != np_invalid) {
+				char hostname[128];
+				hostname[0] = 0;
+				getnameinfo((struct sockaddr*)&sa, salen, hostname, sizeof hostname, NULL, 0, NI_NUMERICHOST);
+				TCHAR *h = au(hostname);
+				write_log(_T("NETPLAY: connection from %s\n"), h);
+				xfree(h);
+				sock = s;
+				setup_socket(sock);
+				np_failed = false;
+				break;
+			}
+			pump_host();
+			if (user_quit()) {
+				fail(_T("Cancelled."));
+				return false;
+			}
+			sleep_millis(5);
+		}
+
+		npmsg m;
+		if (!wait_msg(MSG_HELLO, m, 10000)) {
+			// drop this client and keep waiting
+			close_sockets();
+			if (user_quit() || !host_listen(port))
+				return false;
+			np_failed = false;
+			continue;
+		}
+		npreader r(m.data);
+		uae_u32 magic = r.u32();
+		uae_u16 proto = r.u16();
+		std::string version = r.str();
+		std::string password = r.str();
+		if (r.bad || magic != NP_MAGIC || proto != NP_PROTOCOL) {
+			send_reject(_T("Different netplay protocol version, use the same WinUAE build on both machines."));
+			close_sockets();
+			if (!host_listen(port))
+				return false;
+			np_failed = false;
+			continue;
+		}
+		if (version != version_string()) {
+			TCHAR *v = utf8u(version.c_str());
+			TCHAR *mine = utf8u(version_string().c_str());
+			_stprintf(tmp, _T("Different emulator version: host %s, player 2 %s. Use the same WinUAE build."), mine, v);
+			xfree(mine);
+			xfree(v);
+			send_reject(tmp);
+			close_sockets();
+			if (!host_listen(port))
+				return false;
+			np_failed = false;
+			continue;
+		}
+		if (password != to_utf8(currprefs.netplay_password)) {
+			send_reject(_T("Wrong netplay password."));
+			close_sockets();
+			if (!host_listen(port))
+				return false;
+			np_failed = false;
+			continue;
+		}
+		// one client only
+		if (listener != np_invalid) {
+			np_closesocket(listener);
+			listener = np_invalid;
+		}
+		break;
+	}
+
+	set_status(_T("player 2 connected, measuring ping"));
+	measure_rtt();
+	if (np_failed)
+		return false;
+	if (currprefs.netplay_delay > 0) {
+		np_delay = currprefs.netplay_delay;
+	} else {
+		double frame_ms = 1000.0 / (vblank_hz > 1 ? vblank_hz : 50.0);
+		int oneway = rtt_ms < 0 ? 50 : rtt_ms / 2;
+		np_delay = (int)((oneway + 15 + frame_ms - 1) / frame_ms);
+	}
+	if (np_delay < 1)
+		np_delay = 1;
+	if (np_delay > NP_MAXDELAY)
+		np_delay = NP_MAXDELAY;
+
+	// rndseed in config makes sessions reproducible
+	np_seed = currprefs.seed ? (uae_u32)currprefs.seed : (uae_u32)time(NULL) ^ (uae_u32)now_ms() ^ 0x5a5a1234;
+	if (!np_seed)
+		np_seed = 1;
+	np_swapports = currprefs.netplay_swapports;
+	np_mouse = currprefs.netplay_mouse;
+	np_hashinterval = currprefs.netplay_debug_log[0] ? 1 : NP_HASHINTERVAL;
+
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		if (!load_disk_image(i, disks[i])) {
+			_stprintf(tmp, _T("Cannot read floppy image DF%d: %s"), i, currprefs.floppyslots[i].df);
+			send_reject(tmp);
+			fail(tmp);
+			return false;
+		}
+	}
+
+	npbuf b;
+	b.u32(np_seed);
+	b.u8((uae_u8)np_delay);
+	b.u8((np_swapports ? 1 : 0) | (np_mouse ? 2 : 0));
+	b.u16((uae_u16)np_hashinterval);
+	b.u16((uae_u16)(rtt_ms < 0 ? 0 : rtt_ms));
+	b.u32(rom_crc());
+	b.u8(NP_MAXDRIVES);
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		b.u8(disks[i].present ? 1 : 0);
+		b.u8(disks[i].wp ? 1 : 0);
+		b.u32(disks[i].present ? disks[i].size : 0);
+		b.u32(disks[i].present ? disks[i].crc : 0);
+		b.str(disks[i].present ? disks[i].name : std::string());
+	}
+	std::string cfg = config_text();
+	if (currprefs.netplay_debug_log[0]) {
+		TCHAR *c = utf8u(cfg.c_str());
+		write_log(_T("NETPLAY: compared configuration:\n%s"), c);
+		xfree(c);
+	}
+	b.u32((uae_u32)cfg.size());
+	b.bytes((const uae_u8*)cfg.data(), cfg.size());
+	send_msg(MSG_SETUP, b);
+
+	set_status(_T("checking configuration"));
+	npmsg m;
+	if (!wait_msg(MSG_SETUPREPLY, m, 30000))
+		return false;
+	npreader r(m.data);
+	uae_u8 ok = r.u8();
+	std::string err = r.str();
+	uae_u8 need = r.u8();
+	if (r.bad || !ok) {
+		TCHAR e[1024];
+		from_utf8(e, sizeof e / sizeof(TCHAR), err);
+		_stprintf(tmp, _T("Player 2 cannot join:\n%s"), e);
+		fail(tmp);
+		return false;
+	}
+
+	// floppy images the client does not have yet
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		if (!(need & (1 << i)) || !disks[i].present)
+			continue;
+		_stprintf(tmp, _T("sending DF%d to player 2"), i);
+		set_status(tmp);
+		for (uae_u32 off = 0; off < disks[i].size; off += NP_DISKCHUNK) {
+			uae_u32 len = disks[i].size - off;
+			if (len > NP_DISKCHUNK)
+				len = NP_DISKCHUNK;
+			npbuf d;
+			d.u8((uae_u8)i);
+			d.u32(off);
+			d.bytes(disks[i].data.data() + off, len);
+			send_msg(MSG_DISKDATA, d);
+			// do not queue megabytes, let the socket drain
+			while (outbuf.size() - outpos > 256 * 1024) {
+				if (!np_poll(10))
+					return false;
+				pump_host();
+				if (user_quit()) {
+					fail(_T("Cancelled."));
+					return false;
+				}
+			}
+		}
+	}
+	npbuf s;
+	s.u32(0);
+	send_msg(MSG_START, s);
+	set_status(_T("waiting for player 2"));
+	// client stores the images and inserts them, then both power on
+	if (!wait_msg(MSG_READY, m, 60000))
+		return false;
+	return true;
+}
+
+bool client_handshake(void)
+{
+	TCHAR tmp[1024];
+	std::string host;
+	int port;
+	if (!parse_address(currprefs.netplay_address, host, port)) {
+		fail(_T("No host address. Use netplay_address=<ip or name>[:port]."));
+		return false;
+	}
+	int attempt = 0;
+	TCHAR *hostt = au(host.c_str());
+	TCHAR hostname[256];
+	_tcsncpy(hostname, hostt, sizeof hostname / sizeof(TCHAR) - 1);
+	hostname[sizeof hostname / sizeof(TCHAR) - 1] = 0;
+	xfree(hostt);
+	while (sock == np_invalid) {
+		attempt++;
+		_stprintf(tmp, _T("connecting to %s:%d (attempt %d)"), hostname, port, attempt);
+		set_status(tmp);
+		if (client_connect_once(host, port))
+			break;
+		if (user_quit()) {
+			fail(_T("Cancelled."));
+			return false;
+		}
+		// host may not be up yet
+		uae_s64 start = now_ms();
+		while (now_ms() - start < 1000 && !user_quit()) {
+			pump_host();
+			sleep_millis(10);
+		}
+	}
+	write_log(_T("NETPLAY: connected to %s:%d\n"), hostname, port);
+
+	npbuf b;
+	b.u32(NP_MAGIC);
+	b.u16(NP_PROTOCOL);
+	b.str(version_string());
+	b.str(to_utf8(currprefs.netplay_password));
+	send_msg(MSG_HELLO, b);
+
+	set_status(_T("connected, waiting for host"));
+	npmsg m;
+	if (!wait_msg(MSG_SETUP, m, 60000))
+		return false;
+	npreader r(m.data);
+	np_seed = r.u32();
+	np_delay = r.u8();
+	uae_u8 flags = r.u8();
+	np_hashinterval = r.u16();
+	rtt_ms = r.u16();
+	uae_u32 hostrom = r.u32();
+	int ndrives = r.u8();
+	np_swapports = (flags & 1) != 0;
+	np_mouse = (flags & 2) != 0;
+	for (int i = 0; i < ndrives && i < NP_MAXDRIVES; i++) {
+		disks[i].present = r.u8() != 0;
+		disks[i].wp = r.u8() != 0;
+		disks[i].size = r.u32();
+		disks[i].crc = r.u32();
+		disks[i].name = r.str();
+		disks[i].data.clear();
+		disks[i].received = 0;
+	}
+	uae_u32 cfglen = r.u32();
+	const uae_u8 *cfgp = r.bytes(cfglen);
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		if (disks[i].present && (disks[i].size == 0 || disks[i].size > NP_MAXDISKSIZE))
+			r.bad = true;
+	}
+	if (r.bad || np_delay < 1 || np_delay > NP_MAXDELAY || ndrives != NP_MAXDRIVES) {
+		fail(_T("Protocol error (setup)."));
+		return false;
+	}
+	if (debug_log == NULL && currprefs.netplay_debug_log[0])
+		np_hashinterval = 1;
+	std::string cfg((const char*)cfgp, cfglen);
+
+	std::string err;
+	if (rom_crc() != hostrom)
+		err += "Different Kickstart ROM. Both players need the same ROM (or both the built-in AROS ROM).\n";
+	std::string diff = compare_config(cfg);
+	if (!diff.empty())
+		err += "Different emulator configuration (use the same .uae file):\n" + diff;
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		bool used = currprefs.floppyslots[i].dfxtype >= 0;
+		if (disks[i].present && !used) {
+			err += "Floppy drive DF" + std::to_string(i) + " is disabled here but the host uses it.\n";
+		}
+	}
+
+	uae_u8 need = 0;
+	if (err.empty()) {
+		for (int i = 0; i < NP_MAXDRIVES; i++) {
+			if (!disks[i].present)
+				continue;
+			TCHAR path[MAX_DPATH];
+			disk_cache_path(path, MAX_DPATH, disks[i]);
+			if (!file_crc(path, disks[i].size, disks[i].crc)) {
+				need |= 1 << i;
+				disks[i].data.resize(disks[i].size);
+			}
+			write_log(_T("NETPLAY: DF%d %s\n"), i, (need & (1 << i)) ? _T("will be received from host") : _T("found in cache"));
+		}
+	}
+	npbuf rep;
+	rep.u8(err.empty() ? 1 : 0);
+	rep.str(err);
+	rep.u8(need);
+	send_msg(MSG_SETUPREPLY, rep);
+	if (!err.empty()) {
+		while (outpos < outbuf.size() && np_poll(10));
+		TCHAR e[2048];
+		from_utf8(e, sizeof e / sizeof(TCHAR), err);
+		fail(e);
+		return false;
+	}
+
+	// receive floppy images until START
+	set_status(need ? _T("receiving floppy images") : _T("waiting for host"));
+	for (;;) {
+		for (auto it = inbox.begin(); it != inbox.end(); ) {
+			if (it->type != MSG_DISKDATA) {
+				++it;
+				continue;
+			}
+			npreader d(it->data);
+			int drv = d.u8();
+			uae_u32 off = d.u32();
+			size_t len = it->data.size() - 5;
+			if (d.bad || drv >= NP_MAXDRIVES || !(need & (1 << drv)) || off + len > disks[drv].size) {
+				fail(_T("Protocol error (disk data)."));
+				return false;
+			}
+			memcpy(disks[drv].data.data() + off, it->data.data() + 5, len);
+			disks[drv].received += (uae_u32)len;
+			it = inbox.erase(it);
+		}
+		bool started = false;
+		for (auto it = inbox.begin(); it != inbox.end(); ++it) {
+			if (it->type == MSG_START) {
+				inbox.erase(it);
+				started = true;
+				break;
+			}
+		}
+		if (started)
+			break;
+		if (!np_poll(5))
+			return false;
+		pump_host();
+		if (user_quit()) {
+			fail(_T("Cancelled."));
+			return false;
+		}
+	}
+
+	for (int i = 0; i < NP_MAXDRIVES; i++) {
+		TCHAR path[MAX_DPATH];
+		path[0] = 0;
+		if (disks[i].present) {
+			disk_cache_path(path, MAX_DPATH, disks[i]);
+			if (need & (1 << i)) {
+				if (disks[i].received != disks[i].size || get_crc32(disks[i].data.data(), (int)disks[i].size) != disks[i].crc) {
+					fail(_T("Floppy image transfer failed (checksum)."));
+					return false;
+				}
+				if (!save_file(path, disks[i].data)) {
+					_stprintf(tmp, _T("Cannot write %s"), path);
+					fail(tmp);
+					return false;
+				}
+			}
+			disks[i].data.clear();
+		}
+		// inserted by the hard reset that follows
+		_tcscpy(currprefs.floppyslots[i].df, path);
+		_tcscpy(changed_prefs.floppyslots[i].df, path);
+		currprefs.floppyslots[i].forcedwriteprotect = changed_prefs.floppyslots[i].forcedwriteprotect = disks[i].wp;
+	}
+	npbuf ready;
+	ready.u32(0);
+	send_msg(MSG_READY, ready);
+	while (outpos < outbuf.size()) {
+		if (!np_poll(10))
+			return false;
+	}
+	return true;
+}
+
+}
+
+bool netplay_active(void)
+{
+	return np_state == NP_RUNNING;
+}
+
+bool netplay_pending(void)
+{
+	return currprefs.netplay_mode != NETPLAY_MODE_OFF && !np_started;
+}
+
+bool netplay_port_is_mouse(int port)
+{
+	return port == 0 && np_mouse;
+}
+
+bool netplay_start(void)
+{
+	TCHAR err[1024];
+
+	np_started = true;
+	np_failed = false;
+	np_error[0] = 0;
+	is_host = currprefs.netplay_mode == NETPLAY_MODE_HOST;
+
+	if (!machine_check(err)) {
+		gui_message(_T("Netplay: %s"), err);
+		return false;
+	}
+	if (!start_sockets()) {
+		gui_message(_T("Netplay: network initialization failed."));
+		return false;
+	}
+	np_state = NP_HANDSHAKE;
+	pause_sound();
+	bool ok = is_host ? host_handshake() : client_handshake();
+	resume_sound();
+	if (!ok) {
+		np_state = NP_OFF;
+		close_sockets();
+		set_status(_T(""));
+		if (!user_quit())
+			gui_message(_T("Netplay failed:\n%s\n\nThe game continues without netplay."), np_error);
+		return false;
+	}
+	if (listener != np_invalid) {
+		np_closesocket(listener);
+		listener = np_invalid;
+	}
+	apply_session();
+	return true;
+}
+
+void netplay_stop(const TCHAR *reason)
+{
+	if (np_state == NP_OFF)
+		return;
+	if (sock != np_invalid && !np_failed) {
+		npbuf b;
+		b.str(to_utf8(reason));
+		send_msg(MSG_BYE, b);
+		uae_s64 start = now_ms();
+		while (outpos < outbuf.size() && now_ms() - start < 500 && np_poll(10));
+	}
+	np_state = NP_OFF;
+	close_sockets();
+	if (debug_log)
+		zfile_fclose(debug_log);
+	debug_log = NULL;
+	play.clear();
+	play_pos = 0;
+	write_log(_T("NETPLAY: stopped: %s\n"), reason);
+	write_log(_T("NETPLAY: %u frames, waited for partner %u ms in %u frames, rtt %d ms\n"),
+		cur_frame, (uae_u32)wait_total_ms, wait_frames, rtt_ms);
+	statusline_add_message(STATUSTYPE_OTHER, _T("Netplay ended: %s"), reason);
+	set_status(_T("ended"));
+}
+
+void netplay_exit(void)
+{
+	netplay_stop(_T("WinUAE was closed."));
+	// a restarted emulator connects again
+	np_started = false;
+#ifdef _WIN32
+	if (sockets_started)
+		WSACleanup();
+#endif
+	sockets_started = false;
+}
+
+bool netplay_capture_event(int nr, int state, int max, int autofire)
+{
+	// nothing may touch the Amiga before both machines power on
+	if (np_state == NP_HANDSHAKE)
+		return true;
+	if (np_state != NP_RUNNING)
+		return false;
+	if (nr <= 0 || nr >= INPUTEVENT_END)
+		return true;
+	npevent e;
+	e.nr = (uae_u16)remap[nr];
+	e.flags = autofire ? NPEV_AUTOFIRE : 0;
+	e.state = state;
+	e.max = max;
+	pending_local.push_back(e);
+	return true;
+}
+
+bool netplay_request_reset(int hardreset, int keyboardreset)
+{
+	if (np_state != NP_RUNNING)
+		return false;
+	npevent e;
+	e.nr = 0;
+	e.flags = NPEV_SPECIAL;
+	e.state = hardreset ? NPSPECIAL_HARDRESET : (keyboardreset ? NPSPECIAL_KEYBOARDRESET : NPSPECIAL_SOFTRESET);
+	e.max = 0;
+	pending_local.push_back(e);
+	statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: reset requested"));
+	return true;
+}
+
+bool netplay_allow_inputcode(int code, int state)
+{
+	if (np_state != NP_RUNNING)
+		return true;
+	switch (code)
+	{
+	case AKS_FREEZEBUTTON:
+	case AKS_FLOPPY0: case AKS_FLOPPY1: case AKS_FLOPPY2: case AKS_FLOPPY3:
+	case AKS_EFLOPPY0: case AKS_EFLOPPY1: case AKS_EFLOPPY2: case AKS_EFLOPPY3:
+	case AKS_CD0: case AKS_ECD0:
+	case AKS_IRQ7:
+	case AKS_STATEREWIND: case AKS_STATECURRENT:
+	case AKS_STATERESTOREQUICK: case AKS_STATERESTOREQUICK1: case AKS_STATERESTOREQUICK2:
+	case AKS_STATERESTOREQUICK3: case AKS_STATERESTOREQUICK4: case AKS_STATERESTOREQUICK5:
+	case AKS_STATERESTOREQUICK6: case AKS_STATERESTOREQUICK7: case AKS_STATERESTOREQUICK8:
+	case AKS_STATERESTOREQUICK9: case AKS_STATERESTOREDIALOG:
+	case AKS_RESTART:
+	case AKS_PASTE:
+	case AKS_DISKSWAPPER_INSERT0: case AKS_DISKSWAPPER_INSERT1:
+	case AKS_DISKSWAPPER_INSERT2: case AKS_DISKSWAPPER_INSERT3:
+	case AKS_DISK_PREV0: case AKS_DISK_PREV1: case AKS_DISK_PREV2: case AKS_DISK_PREV3:
+	case AKS_DISK_NEXT0: case AKS_DISK_NEXT1: case AKS_DISK_NEXT2: case AKS_DISK_NEXT3:
+	case AKS_ARCADIADIAGNOSTICS: case AKS_ARCADIAPLY1: case AKS_ARCADIAPLY2:
+	case AKS_ARCADIACOIN1: case AKS_ARCADIACOIN2:
+	case AKS_CDTV_FRONT_PANEL_STOP: case AKS_CDTV_FRONT_PANEL_PLAYPAUSE:
+	case AKS_CDTV_FRONT_PANEL_PREV: case AKS_CDTV_FRONT_PANEL_NEXT:
+	case AKS_CDTV_FRONT_PANEL_REW: case AKS_CDTV_FRONT_PANEL_FF:
+	case AKS_ALGSERVICE: case AKS_ALGLSTART: case AKS_ALGRSTART: case AKS_ALGLCOIN: case AKS_ALGRCOIN:
+	case AKS_ALGLTRIGGER: case AKS_ALGRTRIGGER: case AKS_ALGLHOLSTER: case AKS_ALGRHOLSTER:
+	case AKS_CUBOTOUCH: case AKS_CUBOTEST: case AKS_CUBOCOIN1: case AKS_CUBOCOIN2: case AKS_CUBOCOIN3: case AKS_CUBOCOIN4:
+		if (state)
+			statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: not available during a netplay session"));
+		return false;
+	}
+	return true;
+}
+
+void netplay_frame(void)
+{
+	if (np_state != NP_RUNNING)
+		return;
+
+	if (debug_pos < debug_steps.size())
+		run_debug_script();
+
+	// local input of this frame is applied delay frames later on both machines
+	uae_u32 target = cur_frame + np_delay;
+	npframe &lf = local_frames[target % NP_RING];
+	lf.frame = target;
+	lf.valid = true;
+	lf.ev.swap(pending_local);
+	pending_local.clear();
+	npbuf b;
+	b.u32(target);
+	b.u16((uae_u16)lf.ev.size());
+	for (auto &e : lf.ev) {
+		b.u16(e.nr);
+		b.u8(e.flags);
+		b.u32((uae_u32)e.state);
+		b.u32((uae_u32)e.max);
+	}
+	send_msg(MSG_FRAME, b);
+	if (np_failed) {
+		netplay_stop(np_error);
+		return;
+	}
+	np_poll(0);
+
+	npframe &rf = remote_frames[cur_frame % NP_RING];
+	if (!(rf.valid && rf.frame == cur_frame)) {
+		uae_s64 start = now_ms();
+		bool slow = false;
+		while (!(rf.valid && rf.frame == cur_frame)) {
+			if (!np_poll(2)) {
+				netplay_stop(np_error[0] ? np_error : _T("Connection lost."));
+				return;
+			}
+			pump_host();
+			if (user_quit()) {
+				netplay_stop(_T("WinUAE was closed."));
+				return;
+			}
+			if (!slow && now_ms() - start > 1000) {
+				slow = true;
+				pause_sound();
+				set_status(_T("waiting for partner..."));
+				statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: waiting for partner..."));
+			}
+		}
+		uae_s64 waited = now_ms() - start;
+		wait_total_ms += waited;
+		wait_frames++;
+		if (slow) {
+			resume_sound();
+			TCHAR tmp[256];
+			_stprintf(tmp, _T("%s, delay %d"), is_host ? _T("host") : _T("client"), np_delay);
+			set_status(tmp);
+		}
+	}
+
+	// identical state on both machines at this point
+	if (np_hashinterval > 0 && (cur_frame % np_hashinterval) == 0) {
+		uae_u32 h = state_hash();
+		local_hash[cur_frame] = h;
+		npbuf hb;
+		hb.u32(cur_frame);
+		hb.u32(h);
+		send_msg(MSG_HASH, hb);
+		if (debug_log) {
+			char line[64];
+			sprintf(line, "%u %08x\n", cur_frame, h);
+			zfile_fwrite(line, 1, strlen(line), debug_log);
+		}
+		check_hashes(cur_frame);
+	}
+	if (cur_frame > 0 && (cur_frame % 250) == 0)
+		send_ping((cur_frame / 250) & 15);
+	// settings changed in the GUI on one machine break the session
+	if ((cur_frame % 250) == 125 && !config_change_reported) {
+		std::string diff = compare_config(session_config);
+		if (!diff.empty()) {
+			config_change_reported = true;
+			TCHAR *d = utf8u(diff.c_str());
+			write_log(_T("NETPLAY: configuration changed during the session:\n%s"), d);
+			xfree(d);
+			statusline_add_message(STATUSTYPE_OTHER, _T("Netplay: emulator settings changed during the session, the game may desync"));
+		}
+	}
+
+	// host input first, then client input
+	npframe &mine = local_frames[cur_frame % NP_RING];
+	npframe &first = is_host ? mine : rf;
+	npframe &second = is_host ? rf : mine;
+	play.clear();
+	play_pos = 0;
+	play.insert(play.end(), first.ev.begin(), first.ev.end());
+	play.insert(play.end(), second.ev.begin(), second.ev.end());
+	mine.valid = false;
+	mine.ev.clear();
+	rf.valid = false;
+	rf.ev.clear();
+	cur_frame++;
+}
+
+bool netplay_playevent(int *nr, int *state, int *max, int *autofire)
+{
+	while (play_pos < play.size()) {
+		npevent &e = play[play_pos++];
+		if (e.flags & NPEV_SPECIAL) {
+			switch (e.state)
+			{
+			case NPSPECIAL_SOFTRESET:
+				uae_reset(0, 0);
+				break;
+			case NPSPECIAL_HARDRESET:
+				uae_reset(1, 1);
+				break;
+			case NPSPECIAL_KEYBOARDRESET:
+				uae_reset(0, 1);
+				break;
+			}
+			continue;
+		}
+		*nr = e.nr;
+		*state = e.state;
+		*max = e.max;
+		*autofire = (e.flags & NPEV_AUTOFIRE) ? 1 : 0;
+		return true;
+	}
+	return false;
+}
+
+void netplay_getstatus(TCHAR *out)
+{
+	if (!np_status[0] || currprefs.netplay_mode == NETPLAY_MODE_OFF)
+		return;
+	TCHAR tmp[400];
+	if (np_state == NP_RUNNING && rtt_ms >= 0)
+		_stprintf(tmp, _T("[Netplay %s, %d ms] "), np_status, rtt_ms);
+	else
+		_stprintf(tmp, _T("[Netplay: %s] "), np_status);
+	_tcscat(out, tmp);
+}
