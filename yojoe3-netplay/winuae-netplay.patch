+void fail(const TCHAR *reason)
+{
+	if (!np_failed) {
+		_tcsncpy(np_error, reason, sizeof np_error / sizeof(TCHAR) - 1);
+		np_error[sizeof np_error / sizeof(TCHAR) - 1] = 0;
+		write_log(_T("NETPLAY: %s\n"), np_error);
+	}
+	np_failed = true;
+	if (sock != np_invalid)
+		np_closesocket(sock);
+	sock = np_invalid;
+}
