+#ifdef _WIN32
+typedef SOCKET np_socket;
+const np_socket np_invalid = INVALID_SOCKET;
+void np_closesocket(np_socket s) { closesocket(s); }
+bool np_wouldblock(void)
+{
+	int e = WSAGetLastError();
+	return e == WSAEWOULDBLOCK || e == WSAEINPROGRESS || e == WSAEINTR;
+}
+bool np_nonblocking(np_socket s) { u_long one = 1; return ioctlsocket(s, FIONBIO, &one) == 0; }
+#else
+typedef int np_socket;
+const np_socket np_invalid = -1;
+void np_closesocket(np_socket s) { close(s); }
+bool np_wouldblock(void) { return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR || errno == EINPROGRESS; }
+bool np_nonblocking(np_socket s)
+{
+	int flags = fcntl(s, F_GETFL, 0);
+	return flags >= 0 && fcntl(s, F_SETFL, flags | O_NONBLOCK) == 0;
+}
