diff --git a/netplay.cpp b/netplay.cpp
new file mode 100644
index 0000000..7e34618
--- /dev/null
+++ b/netplay.cpp
@@ -0,0 +1,1941 @@
+/*
+* UAE - The Un*x Amiga Emulator
+*
+* Netplay: two emulators run the same Amiga in lockstep over TCP.
+*
+* Both machines start from the same power-on state (same configuration,
+* ROM, floppy images and random seed) and only input events travel over
+* the network. Input captured on frame N is applied on both machines at
+* frame N + delay, at the same emulated position (vpos 0), so emulation
+* stays identical. Memory/CPU checksums are exchanged to detect desync.
+*
+* The host owns Amiga joystick port 2 (player 1 in most games), the
+* client's joystick is moved to joystick port 1 (the mouse port).
+*
+*/
+
+#include "sysconfig.h"
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <sys/select.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#endif
+#include "sysdeps.h"
+
+#include "options.h"
+#include "uae.h"
+#include "custom.h"
+#include "memory.h"
+#include "newcpu.h"
+#include "inputdevice.h"
+#include "keyboard.h"
+#include "disk.h"
+#include "zfile.h"
+#include "crc32.h"
+#include "statusline.h"
+#include "xwin.h"
+#include "fsdb.h"
+#include "devices.h"
+#include "savestate.h"
+#include "sounddep/sound.h"
+#include "netplay.h"
+
+#include <vector>
+#include <string>
+#include <deque>
+#include <map>
+#include <chrono>
+
+#if defined(_MSC_VER)
+#pragma comment(lib, "ws2_32.lib")
+#endif
+
+#define NP_MAGIC 0x57554e50 /* 'WUNP' */
+#define NP_PROTOCOL 1
+#define NP_RING 128
+#define NP_MAXDELAY 15
+#define NP_MAXMSG (4 * 1024 * 1024)
+#define NP_DISKCHUNK 32768
+#define NP_HASHINTERVAL 50
+#define NP_MAXDRIVES 4
+#define NP_MAXDISKSIZE (64 * 1024 * 1024)
+
+enum {
+	MSG_HELLO = 1,
+	MSG_REJECT,
+	MSG_PING,
+	MSG_PONG,
+	MSG_SETUP,
+	MSG_SETUPREPLY,
+	MSG_DISKDATA,
+	MSG_START,
+	MSG_FRAME,
+	MSG_HASH,
+	MSG_BYE,
+	MSG_READY
+};
+
+#define NPEV_AUTOFIRE 1
+#define NPEV_SPECIAL 0x80
+
+#define NPSPECIAL_SOFTRESET 1
+#define NPSPECIAL_HARDRESET 2
+#define NPSPECIAL_KEYBOARDRESET 3
+
+enum { NP_OFF, NP_HANDSHAKE, NP_RUNNING };
+
+namespace {
+
+#ifdef _WIN32
+typedef SOCKET np_socket;
+const np_socket np_invalid = INVALID_SOCKET;
+void np_closesocket(np_socket s) { closesocket(s); }
+bool np_wouldblock(void)
+{
+	int e = WSAGetLastError();
+	return e == WSAEWOULDBLOCK || e == WSAEINPROGRESS || e == WSAEINTR;
+}
+bool np_nonblocking(np_socket s) { u_long one = 1; return ioctlsocket(s, FIONBIO, &one) == 0; }
+#else
+typedef int np_socket;
+const np_socket np_invalid = -1;
+void np_closesocket(np_socket s) { close(s); }
+bool np_wouldblock(void) { return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR || errno == EINPROGRESS; }
+bool np_nonblocking(np_socket s)
+{
+	int flags = fcntl(s, F_GETFL, 0);
+	return flags >= 0 && fcntl(s, F_SETFL, flags | O_NONBLOCK) == 0;
+}
+#endif
+
+struct npbuf
+{
+	std::vector<uae_u8> d;
+	void u8(uae_u8 v) { d.push_back(v); }
+	void u16(uae_u16 v) { u8((uae_u8)(v >> 8)); u8((uae_u8)v); }
+	void u32(uae_u32 v) { u16((uae_u16)(v >> 16)); u16((uae_u16)v); }
+	void str(const std::string &s)
+	{
+		size_t len = s.size() > 65535 ? 65535 : s.size();
+		u16((uae_u16)len);
+		d.insert(d.end(), s.begin(), s.begin() + len);
+	}
+	void bytes(const uae_u8 *p, size_t len) { d.insert(d.end(), p, p + len); }
+};
+
+struct npreader
+{
+	const uae_u8 *p;
+	size_t len, pos;
+	bool bad;
+	npreader(const std::vector<uae_u8> &v) : p(v.data()), len(v.size()), pos(0), bad(false) { }
+	uae_u8 u8(void)
+	{
+		if (pos + 1 > len) {
+			bad = true;
+			return 0;
+		}
+		return p[pos++];
+	}
+	uae_u16 u16(void) { uae_u16 v = u8() << 8; return v | u8(); }
+	uae_u32 u32(void) { uae_u32 v = u16() << 16; return v | u16(); }
+	std::string str(void)
+	{
+		size_t l = u16();
+		if (bad || pos + l > len) {
+			bad = true;
+			return std::string();
+		}
+		std::string s((const char*)p + pos, l);
+		pos += l;
+		return s;
+	}
+	const uae_u8 *bytes(size_t l)
+	{
+		if (pos + l > len) {
+			bad = true;
+			return NULL;
+		}
+		const uae_u8 *r = p + pos;
+		pos += l;
+		return r;
+	}
+};
+
+struct npmsg
+{
+	uae_u8 type;
+	std::vector<uae_u8> data;
+};
+
+struct npevent
+{
+	uae_u16 nr;
+	uae_u8 flags;
+	uae_s32 state;
+	uae_s32 max;
+};
+
+struct npframe
+{
+	uae_u32 frame;
+	bool valid;
+	std::vector<npevent> ev;
+};
+
+struct npdisk
+{
+	bool present;
+	bool wp;
+	uae_u32 size, crc;
+	std::string name;
+	std::vector<uae_u8> data;
+	uae_u32 received;
+};
+
+struct npdebugstep
+{
+	uae_u32 frame;
+	int action;
+	int nr, state;
+	std::string arg;
+};
+
+int np_state = NP_OFF;
+bool np_started;
+bool sockets_started;
+bool is_host;
+np_socket listener = np_invalid, sock = np_invalid;
+std::vector<uae_u8> inbuf, outbuf;
+size_t outpos;
+std::deque<npmsg> inbox;
+TCHAR np_error[512];
+TCHAR np_status[256];
+bool np_failed;
+
+uae_u32 np_seed;
+int np_delay;
+bool np_swapports;
+bool np_mouse;
+int np_hashinterval;
+
+uae_u32 cur_frame;
+npframe local_frames[NP_RING], remote_frames[NP_RING];
+std::vector<npevent> pending_local, play;
+size_t play_pos;
+std::map<uae_u32, uae_u32> local_hash, remote_hash;
+bool desync_reported;
+int remap[INPUTEVENT_END];
+
+int rtt_ms = -1;
+int pongs;
+std::chrono::steady_clock::time_point ping_sent[16];
+uae_u64 wait_total_ms;
+uae_u32 wait_frames;
+
+npdisk disks[NP_MAXDRIVES];
+
+std::string session_config;
+bool config_change_reported;
+
+std::vector<npdebugstep> debug_steps;
+size_t debug_pos;
+struct zfile *debug_log;
+
+uae_s64 now_ms(void)
+{
+	return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+std::string to_utf8(const TCHAR *s)
+{
+	char *c = uutf8(s);
+	std::string r(c ? c : "");
+	xfree(c);
+	return r;
+}
+
+void from_utf8(TCHAR *out, int maxlen, const std::string &s)
+{
+	TCHAR *t = utf8u(s.c_str());
+	_tcsncpy(out, t ? t : _T(""), maxlen - 1);
+	out[maxlen - 1] = 0;
+	xfree(t);
+}
+
+void set_status(const TCHAR *s)
+{
+	if (_tcscmp(np_status, s)) {
+		_tcsncpy(np_status, s, sizeof np_status / sizeof(TCHAR) - 1);
+		np_status[sizeof np_status / sizeof(TCHAR) - 1] = 0;
+		refreshtitle();
+	}
+}
+
+void close_sockets(void)
+{
+	if (sock != np_invalid)
+		np_closesocket(sock);
+	sock = np_invalid;
+	if (listener != np_invalid)
+		np_closesocket(listener);
+	listener = np_invalid;
+	inbuf.clear();
+	outbuf.clear();
+	outpos = 0;
+	inbox.clear();
+}
+
+void fail(const TCHAR *reason)
+{
+	if (!np_failed) {
+		_tcsncpy(np_error, reason, sizeof np_error / sizeof(TCHAR) - 1);
+		np_error[sizeof np_error / sizeof(TCHAR) - 1] = 0;
+		write_log(_T("NETPLAY: %s\n"), np_error);
+	}
+	np_failed = true;
+	if (sock != np_invalid)
+		np_closesocket(sock);
+	sock = np_invalid;
+}
+
+bool start_sockets(void)
+{
+	if (sockets_started)
+		return true;
+#ifdef _WIN32
+	WSADATA data;
+	if (WSAStartup(MAKEWORD(2, 2), &data))
+		return false;
+#endif
+	sockets_started = true;
+	return true;
+}
+
+void setup_socket(np_socket s)
+{
+	int one = 1;
+	setsockopt(s, IPPROTO_TCP, TCP_NODELAY, (const char*)&one, sizeof one);
+#ifdef SO_NOSIGPIPE
+	setsockopt(s, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
+#endif
+	np_nonblocking(s);
+}
+
+bool flush_out(void)
+{
+	if (sock == np_invalid)
+		return false;
+	while (outpos < outbuf.size()) {
+		int flags = 0;
+#ifdef MSG_NOSIGNAL
+		flags = MSG_NOSIGNAL;
+#endif
+		size_t left = outbuf.size() - outpos;
+		int len = left > 65536 ? 65536 : (int)left;
+		int n = (int)send(sock, (const char*)outbuf.data() + outpos, len, flags);
+		if (n > 0) {
+			outpos += n;
+		} else if (n < 0 && np_wouldblock()) {
+			break;
+		} else {
+			fail(_T("Connection lost (send)."));
+			return false;
+		}
+	}
+	if (outpos >= outbuf.size()) {
+		outbuf.clear();
+		outpos = 0;
+	} else if (outpos > 1024 * 1024) {
+		outbuf.erase(outbuf.begin(), outbuf.begin() + outpos);
+		outpos = 0;
+	}
+	return true;
+}
+
+void send_msg(uae_u8 type, const npbuf &b)
+{
+	if (sock == np_invalid)
+		return;
+	uae_u32 len = (uae_u32)b.d.size() + 1;
+	outbuf.push_back((uae_u8)(len >> 24));
+	outbuf.push_back((uae_u8)(len >> 16));
+	outbuf.push_back((uae_u8)(len >> 8));
+	outbuf.push_back((uae_u8)len);
+	outbuf.push_back(type);
+	outbuf.insert(outbuf.end(), b.d.begin(), b.d.end());
+	flush_out();
+}
+
+void send_reject(const TCHAR *reason)
+{
+	npbuf b;
+	b.str(to_utf8(reason));
+	send_msg(MSG_REJECT, b);
+	flush_out();
+}
+
+void handle_frame_msg(const npmsg &m);
+void handle_hash_msg(const npmsg &m);
+
+// messages that can arrive at any time are handled here, the rest is queued
+void dispatch(npmsg &m)
+{
+	switch (m.type)
+	{
+	case MSG_PING:
+	{
+		npbuf b;
+		b.bytes(m.data.data(), m.data.size());
+		send_msg(MSG_PONG, b);
+		break;
+	}
+	case MSG_PONG:
+	{
+		npreader r(m.data);
+		uae_u32 id = r.u32();
+		if (!r.bad && id < 16) {
+			int ms = (int)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - ping_sent[id]).count();
+			rtt_ms = rtt_ms < 0 ? ms : (rtt_ms * 3 + ms) / 4;
+			pongs++;
+		}
+		break;
+	}
+	case MSG_FRAME:
+		handle_frame_msg(m);
+		break;
+	case MSG_HASH:
+		handle_hash_msg(m);
+		break;
+	case MSG_BYE:
+	case MSG_REJECT:
+	{
+		npreader r(m.data);
+		TCHAR reason[256];
+		from_utf8(reason, sizeof reason / sizeof(TCHAR), r.str());
+		TCHAR tmp[512];
+		_stprintf(tmp, _T("%s: %s"), m.type == MSG_BYE ? _T("Partner left") : _T("Connection refused"), reason);
+		fail(tmp);
+		break;
+	}
+	default:
+		inbox.push_back(std::move(m));
+		break;
+	}
+}
+
+bool read_in(void)
+{
+	if (sock == np_invalid)
+		return false;
+	uae_u8 tmp[65536];
+	bool closed = false;
+	for (int i = 0; i < 64; i++) {
+		int n = (int)recv(sock, (char*)tmp, sizeof tmp, 0);
+		if (n > 0) {
+			inbuf.insert(inbuf.end(), tmp, tmp + n);
+		} else if (n < 0 && np_wouldblock()) {
+			break;
+		} else {
+			// parse what we have first, partner may have sent BYE
+			closed = true;
+			break;
+		}
+		if (n < (int)sizeof tmp)
+			break;
+	}
+	size_t pos = 0;
+	while (inbuf.size() - pos >= 5) {
+		const uae_u8 *p = inbuf.data() + pos;
+		uae_u32 len = (p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
+		if (len == 0 || len > NP_MAXMSG) {
+			fail(_T("Protocol error."));
+			return false;
+		}
+		if (inbuf.size() - pos < 4 + len)
+			break;
+		npmsg m;
+		m.type = p[4];
+		m.data.assign(p + 5, p + 4 + len);
+		pos += 4 + len;
+		dispatch(m);
+		if (np_failed)
+			return false;
+	}
+	if (pos)
+		inbuf.erase(inbuf.begin(), inbuf.begin() + pos);
+	if (closed) {
+		fail(_T("Partner disconnected."));
+		return false;
+	}
+	return true;
+}
+
+// wait up to timeout ms for network activity, process it
+bool np_poll(int timeout)
+{
+	if (np_failed || sock == np_invalid)
+		return false;
+	fd_set rfds, wfds;
+	FD_ZERO(&rfds);
+	FD_ZERO(&wfds);
+	FD_SET(sock, &rfds);
+	if (outpos < outbuf.size())
+		FD_SET(sock, &wfds);
+	struct timeval tv;
+	tv.tv_sec = timeout / 1000;
+	tv.tv_usec = (timeout % 1000) * 1000;
+	int n = select((int)sock + 1, &rfds, &wfds, NULL, &tv);
+	if (n < 0) {
+		if (np_wouldblock())
+			return true;
+		fail(_T("Network error (select)."));
+		return false;
+	}
+	if (n > 0 && FD_ISSET(sock, &wfds)) {
+		if (!flush_out())
+			return false;
+	}
+	if (n > 0 && FD_ISSET(sock, &rfds)) {
+		if (!read_in())
+			return false;
+	}
+	return !np_failed;
+}
+
+bool user_quit(void)
+{
+	return quit_program == -UAE_QUIT || quit_program == UAE_QUIT;
+}
+
+void pump_host(void)
+{
+	static uae_s64 last;
+	uae_s64 t = now_ms();
+	if (t - last >= 10) {
+		last = t;
+		handle_msgpump(true);
+	}
+}
+
+// wait until a message of given type is queued
+bool wait_msg(uae_u8 type, npmsg &out, int timeout_ms)
+{
+	uae_s64 start = now_ms();
+	for (;;) {
+		for (auto it = inbox.begin(); it != inbox.end(); ++it) {
+			if (it->type == type) {
+				out = std::move(*it);
+				inbox.erase(it);
+				return true;
+			}
+		}
+		if (!np_poll(5))
+			return false;
+		pump_host();
+		if (user_quit()) {
+			fail(_T("Cancelled."));
+			return false;
+		}
+		if (timeout_ms > 0 && now_ms() - start > timeout_ms) {
+			fail(_T("Partner did not respond (timeout)."));
+			return false;
+		}
+	}
+}
