+bool parse_address(const TCHAR *addr, std::string &host, int &port)
+{
+	std::string a = to_utf8(addr);
+	port = currprefs.netplay_port > 0 ? currprefs.netplay_port : NETPLAY_DEFAULT_PORT;
+	if (a.empty())
+		return false;
+	if (a[0] == '[') {
+		size_t e = a.find(']');
+		if (e == std::string::npos)
+			return false;
+		host = a.substr(1, e - 1);
+		if (e + 1 < a.size() && a[e + 1] == ':')
+			port = atoi(a.c_str() + e + 2);
+	} else {
+		size_t c = a.find(':');
+		if (c != std::string::npos && a.find(':', c + 1) == std::string::npos) {
+			host = a.substr(0, c);
+			port = atoi(a.c_str() + c + 1);
+		} else {
+			host = a;
+		}
+	}
+	return !host.empty() && port > 0 && port < 65536;
+}
+
+bool host_listen(int port)
+{
+	struct sockaddr_in6 a6;
+	struct sockaddr_in a4;
+	int one = 1, zero = 0;
+
+	listener = socket(AF_INET6, SOCK_STREAM, 0);
+	if (listener != np_invalid) {
+		setsockopt(listener, IPPROTO_IPV6, IPV6_V6ONLY, (const char*)&zero, sizeof zero);
+#ifndef _WIN32
+		setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+#endif
+		// all zero address is in6addr_any
+		memset(&a6, 0, sizeof a6);
+		a6.sin6_family = AF_INET6;
+		a6.sin6_port = htons((unsigned short)port);
+		if (bind(listener, (struct sockaddr*)&a6, sizeof a6) || listen(listener, 1)) {
+			np_closesocket(listener);
+			listener = np_invalid;
+		}
+	}
+	if (listener == np_invalid) {
+		listener = socket(AF_INET, SOCK_STREAM, 0);
+		if (listener == np_invalid)
+			return false;
+#ifndef _WIN32
+		setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+#endif
+		memset(&a4, 0, sizeof a4);
+		a4.sin_family = AF_INET;
+		a4.sin_port = htons((unsigned short)port);
+		a4.sin_addr.s_addr = htonl(INADDR_ANY);
+		if (bind(listener, (struct sockaddr*)&a4, sizeof a4) || listen(listener, 1)) {
+			np_closesocket(listener);
+			listener = np_invalid;
+			return false;
+		}
+	}
+	np_nonblocking(listener);
+	return true;
+}
+
+bool client_connect_once(const std::string &host, int port)
+{
+	struct addrinfo hints, *res = NULL;
+	char portstr[16];
+	memset(&hints, 0, sizeof hints);
+	hints.ai_family = AF_UNSPEC;
+	hints.ai_socktype = SOCK_STREAM;
+	sprintf(portstr, "%d", port);
+	if (getaddrinfo(host.c_str(), portstr, &hints, &res) || !res)
+		return false;
+	bool ok = false;
+	for (struct addrinfo *ai = res; ai && !ok && !user_quit(); ai = ai->ai_next) {
+		np_socket s = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
+		if (s == np_invalid)
+			continue;
+		np_nonblocking(s);
+		int r = connect(s, ai->ai_addr, (int)ai->ai_addrlen);
+		if (r != 0 && !np_wouldblock()) {
+			np_closesocket(s);
+			continue;
+		}
+		// wait for connect, keep window alive
+		uae_s64 start = now_ms();
+		bool done = r == 0;
+		while (!done && now_ms() - start < 3000 && !user_quit()) {
+			fd_set wfds, efds;
+			FD_ZERO(&wfds);
+			FD_ZERO(&efds);
+			FD_SET(s, &wfds);
+			FD_SET(s, &efds);
+			struct timeval tv = { 0, 10000 };
+			int n = select((int)s + 1, NULL, &wfds, &efds, &tv);
+			if (n > 0) {
+				int err = 0;
+				socklen_t len = sizeof err;
+				getsockopt(s, SOL_SOCKET, SO_ERROR, (char*)&err, &len);
+				if (err == 0 && FD_ISSET(s, &wfds))
+					done = true;
+				else
+					break;
+			}
+			pump_host();
+		}
+		if (done) {
+			sock = s;
+			setup_socket(sock);
+			ok = true;
+		} else {
+			np_closesocket(s);
+		}
+	}
+	freeaddrinfo(res);
+	return ok;
+}
+
+uae_u32 bank_crc(addrbank *ab)
+{
+	if (!ab->baseaddr || !ab->allocated_size)
+		return 0;
+	return get_crc32(ab->baseaddr, ab->allocated_size);
+}
+
+// RAM checksum; big boards are checked 1 MB per call, all of it over time
+uae_u32 ram_crc(addrbank *ab)
+{
+	const uae_u32 slice = 1024 * 1024;
+	if (!ab->baseaddr || ab->allocated_size <= 2 * slice)
+		return bank_crc(ab);
+	uae_u32 n = (uae_u32)(ab->allocated_size / slice);
+	uae_u32 i = (cur_frame / (np_hashinterval > 0 ? np_hashinterval : 1)) % n;
+	return get_crc32(ab->baseaddr + i * slice, slice);
+}
+
+uae_u32 state_hash(void)
+{
+	uae_u32 v[64];
+	int n = 0;
+	v[n++] = ram_crc(&chipmem_bank);
+	v[n++] = ram_crc(&bogomem_bank);
+	// non-autoconfig RAM is added for the built-in AROS ROM
+	v[n++] = ram_crc(&custmem1_bank);
+	v[n++] = ram_crc(&custmem2_bank);
+	v[n++] = ram_crc(&mem25bit_bank);
+	for (int i = 0; i < MAX_RAM_BOARDS; i++) {
+		v[n++] = ram_crc(&fastmem_bank[i]);
+		v[n++] = ram_crc(&z3fastmem_bank[i]);
+	}
+	for (int i = 0; i < 16; i++)
+		v[n++] = m68k_dreg(regs, i);
+	v[n++] = m68k_getpc();
+	v[n++] = hsync_counter;
+	v[n++] = vpos;
+	v[n++] = uaerandgetseed();
+	return get_crc32(v, n * sizeof(uae_u32));
+}
+
+uae_u32 rom_crc(void)
+{
+	uae_u32 c = bank_crc(&kickmem_bank);
+	return c ^ (bank_crc(&extendedkickmem_bank) * 3);
+}
