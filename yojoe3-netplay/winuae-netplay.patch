+// Esc in the emulator window cancels waiting for the partner
+bool esc_pressed(void)
+{
+#ifdef _WIN32
+	if (!(GetAsyncKeyState(VK_ESCAPE) & 0x8000))
+		return false;
+	DWORD pid = 0;
+	GetWindowThreadProcessId(GetForegroundWindow(), &pid);
+	return pid == GetCurrentProcessId();
+#else
+	return false;
+#endif
+}
